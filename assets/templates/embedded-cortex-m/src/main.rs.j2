//! {{ name }} — bare-metal firmware for ARM Cortex-M.
//!
//! Logs go through defmt over RTT: `cargo run` flashes the board with
//! probe-rs and prints them. Panics print through defmt too.

#![no_main]
#![no_std]

use defmt_rtt as _; // global logger: defmt frames over RTT
use panic_probe as _; // panic handler: print over defmt, then halt

#[cortex_m_rt::entry]
fn main() -> ! {
    defmt::info!("{{ name }} started");

    loop {
        // Sleep until the next interrupt — the place for your firmware logic.
        cortex_m::asm::wfi();
    }
}
