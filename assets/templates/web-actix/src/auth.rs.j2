{%- elif backend.database == 'diesel' %}

diesel::table! {
    users (id) {
        id -> Int4,
        username -> Text,
        password_hash -> Text,
    }
}

#[derive(Insertable)]
#[diesel(table_name = users)]
struct NewUser<'a> {
    username: &'a str,
    password_hash: &'a str,
}

/// Create the users table when missing. Called once at startup.
pub fn migrate(db: &Db) {
    let mut conn = db.get().expect("database connection");
    diesel::sql_query(
        "CREATE TABLE IF NOT EXISTS users (\
            id SERIAL PRIMARY KEY, \
            username TEXT NOT NULL UNIQUE, \
            password_hash TEXT NOT NULL)",
    )
    .execute(&mut conn)
    .expect("failed to create the users table");
}

/// Insert a user; false when the username is taken. Diesel is blocking:
/// call this inside `web::block` (see the handlers below).
fn create_user(db: &Db, username: &str, password_hash: &str) -> Result<bool, diesel::result::Error> {
    let mut conn = db.get().expect("database connection");
    let inserted = diesel::insert_into(users::table)
        .values(&NewUser {
            username,
            password_hash,
        })
        .on_conflict_do_nothing()
        .execute(&mut conn)?;
    Ok(inserted > 0)
}

fn password_hash_of(db: &Db, username: &str) -> Result<Option<String>, diesel::result::Error> {
    let mut conn = db.get().expect("database connection");
    users::table
        .filter(users::username.eq(username))
        .select(users::password_hash)
        .first(&mut conn)
        .optional()
}
