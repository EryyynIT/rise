/// Register a new user: 201 Created, 409 when the name is taken, 400 on
/// empty credentials.
#[post("/auth/register")]
pub async fn register(db: web::Data<Db>, credentials: web::Json<Credentials>) -> HttpResponse {
    if credentials.username.is_empty() || credentials.password.is_empty() {
        return HttpResponse::BadRequest().finish();
    }
    let Ok(password_hash) = hash_password(&credentials.password) else {
        return HttpResponse::InternalServerError().finish();
    };
{%- if backend.database == 'diesel' %}
    let created = web::block(move || create_user(&db, &credentials.username, &password_hash)).await;
    match created {
        Ok(Ok(true)) => HttpResponse::Created().finish(),
        Ok(Ok(false)) => HttpResponse::Conflict().finish(),
        _ => HttpResponse::InternalServerError().finish(),
    }
{%- elif backend.database == 'sled' %}
    match create_user(&db, &credentials.username, &password_hash) {
        Ok(true) => HttpResponse::Created().finish(),
        Ok(false) => HttpResponse::Conflict().finish(),
        Err(_) => HttpResponse::InternalServerError().finish(),
    }
{%- else %}
    match create_user(&db, &credentials.username, &password_hash).await {
        Ok(true) => HttpResponse::Created().finish(),
        Ok(false) => HttpResponse::Conflict().finish(),
        Err(_) => HttpResponse::InternalServerError().finish(),
    }
{%- endif %}
}

/// Log in: 200 with a signed JWT in the body, 401 on bad credentials.
#[post("/auth/login")]
pub async fn login(db: web::Data<Db>, credentials: web::Json<Credentials>) -> HttpResponse {
{%- if backend.database == 'diesel' %}
    let username = credentials.username.clone();
    let stored = match web::block(move || password_hash_of(&db, &username)).await {
        Ok(Ok(stored)) => stored,
        _ => return HttpResponse::InternalServerError().finish(),
    };
{%- elif backend.database == 'sled' %}
    let stored = match password_hash_of(&db, &credentials.username) {
        Ok(stored) => stored,
        Err(_) => return HttpResponse::InternalServerError().finish(),
    };
{%- else %}
    let stored = match password_hash_of(&db, &credentials.username).await {
        Ok(stored) => stored,
        Err(_) => return HttpResponse::InternalServerError().finish(),
    };
{%- endif %}
    match stored {
        Some(hash) if verify_password(&hash, &credentials.password) => {
            match issue_token(&credentials.username) {
                Ok(token) => HttpResponse::Ok().body(token),
                Err(_) => HttpResponse::InternalServerError().finish(),
            }
        }
        _ => HttpResponse::Unauthorized().finish(),
    }
}

/// Protected example: returns the token's subject.
#[get("/api/me")]
pub async fn me(user: AuthUser) -> impl Responder {
    format!("hello, {}", user.0)
}

/// Extracts the bearer token's subject; 401 when missing or invalid.
pub struct AuthUser(pub String);

impl FromRequest for AuthUser {
    type Error = actix_web::Error;
    type Future = std::future::Ready<Result<Self, Self::Error>>;

    fn from_request(
        req: &HttpRequest,
        _payload: &mut actix_web::dev::Payload,
    ) -> Self::Future {
        let user = req
            .headers()
            .get(header::AUTHORIZATION)
            .and_then(|value| value.to_str().ok())
            .and_then(|value| value.strip_prefix("Bearer "))
            .and_then(validate_token)
            .map(|claims| AuthUser(claims.sub));
        std::future::ready(
            user.ok_or_else(|| actix_web::error::ErrorUnauthorized("missing or invalid token")),
        )
    }
}

fn hash_password(password: &str) -> Result<String, argon2::password_hash::Error> {
    Ok(Argon2::default()
        .hash_password(password.as_bytes())?
        .to_string())
}

fn verify_password(hash: &str, password: &str) -> bool {
    PasswordHash::new(hash)
        .map(|hash| {
            Argon2::default()
                .verify_password(password.as_bytes(), &hash)
                .is_ok()
        })
        .unwrap_or(false)
}

fn issue_token(username: &str) -> Result<String, jsonwebtoken::errors::Error> {
    let claims = Claims {
        sub: username.to_owned(),
        exp: jsonwebtoken::get_current_timestamp() as usize + 24 * 60 * 60,
    };
    jsonwebtoken::encode(
        &Header::default(),
        &claims,
        &EncodingKey::from_secret(JWT_SECRET.as_bytes()),
    )
}

fn validate_token(token: &str) -> Option<Claims> {
    jsonwebtoken::decode::<Claims>(
        token,
        &DecodingKey::from_secret(JWT_SECRET.as_bytes()),
        &Validation::default(),
    )
    .ok()
    .map(|data| data.claims)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn a_hashed_password_verifies_and_a_wrong_one_does_not() {
        let hash = hash_password("correct horse").expect("hashing works");
        assert!(verify_password(&hash, "correct horse"));
        assert!(!verify_password(&hash, "a different password"));
        assert!(!verify_password("not a phc hash", "correct horse"));
    }
}
