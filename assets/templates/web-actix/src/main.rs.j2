use actix_web::{App, HttpServer, Responder, get};
{%- if 'web-sockets' in backend.features %}
use actix_web::{HttpRequest, HttpResponse};
{%- endif %}
{%- if backend.database == 'sqlx' %}

mod db;
{%- endif %}

#[get("/")]
async fn root() -> impl Responder {
    "Hello from {{ name }}!"
}
{%- if 'web-sockets' in backend.features %}

/// WebSocket echo endpoint: sends every text message back.
#[get("/ws")]
async fn ws(
    req: HttpRequest,
    body: actix_web::web::Payload,
) -> actix_web::Result<HttpResponse> {
    let (response, mut session, mut msg_stream) = actix_ws::handle(&req, body)?;
    actix_web::rt::spawn(async move {
        while let Some(Ok(actix_ws::Message::Text(text))) = msg_stream.recv().await {
            if session.text(text).await.is_err() {
                break;
            }
        }
    });
    Ok(response)
}
{%- endif %}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
{%- if backend.database == 'sqlx' %}
    let pool = db::create_pool().await.expect("failed to connect to database");
{%- endif %}
    println!("listening on http://localhost:3000");
    HttpServer::new(move || {
        let app = App::new().service(root);
{%- if 'web-sockets' in backend.features %}
        let app = app.service(ws);
{%- endif %}
{%- if backend.database == 'sqlx' %}
        app.app_data(actix_web::web::Data::new(pool.clone()))
{%- else %}
        app
{%- endif %}
    })
    .bind(("0.0.0.0", 3000))?
    .run()
    .await
}
{%- if 'api' in backend.testing %}

#[cfg(test)]
mod tests {
    use super::*;
    use actix_web::{App, http::StatusCode, test};

    #[actix_web::test]
    async fn root_says_hello() {
        let app = test::init_service(App::new().service(root)).await;
        let req = test::TestRequest::get().uri("/").to_request();
        let resp = test::call_service(&app, req).await;
        assert_eq!(resp.status(), StatusCode::OK);
    }
}
{%- endif %}
{%- if 'sqlx' in backend.testing and backend.database == 'sqlx' %}

#[cfg(test)]
mod db_tests {
    #[actix_web::test]
    #[ignore = "needs a running Postgres (set DATABASE_URL)"]
    async fn pool_connects() {
        let pool = crate::db::create_pool().await.expect("connect");
        let row: (i64,) = sqlx::query_as("SELECT 1")
            .fetch_one(&pool)
            .await
            .expect("query");
        assert_eq!(row.0, 1);
    }
}
