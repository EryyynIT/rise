[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "2024"

[dependencies]
{%- if 'web-sockets' in backend.features %}
axum = { version = "0.8", features = ["ws"] }
{%- else %}
axum = "0.8"
{%- endif %}
tokio = { version = "1", features = ["full"] }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
{%- if 'rate-limiting' in backend.features %}
tower_governor = "0.8"
{%- endif %}
{%- if 'graph-ql' in backend.features %}
async-graphql = "7"
async-graphql-axum = "7"
{%- endif %}
{%- if 'grpc' in backend.features %}
tonic = "0.14"
tonic-prost = "0.14"
prost = "0.14"
{%- endif %}
{%- if 'auth' in backend.features %}
argon2 = "0.6"
# rust_crypto selects the pure-Rust HMAC backend (no ring/aws-lc C builds).
jsonwebtoken = { version = "11", features = ["rust_crypto"] }
serde = { version = "1", features = ["derive"] }
{%- endif %}
{%- if frontend == 'yew' or 'cors' in backend.features %}
tower-http = { version = "0.6", features = [{% if frontend == 'yew' %}"fs"{% endif %}{% if frontend == 'yew' and 'cors' in backend.features %}, {% endif %}{% if 'cors' in backend.features %}"cors"{% endif %}] }
{%- endif %}
{%- if frontend == 'askama' %}
askama = "0.16"
{%- elif frontend == 'tera' %}
tera = "2"
{%- elif frontend == 'minijinja' %}
minijinja = "3"
{%- elif frontend == 'handlebars' %}
handlebars = "6"
serde_json = "1"
{%- endif %}
{%- if backend.database == 'sqlx' %}
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }
{%- elif backend.database == 'sqlite' %}
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "sqlite"] }
{%- elif backend.database == 'diesel' %}
diesel = { version = "2", features = ["postgres", "r2d2"] }
{%- elif backend.database == 'sea-orm' %}
sea-orm = { version = "1", features = ["sqlx-postgres", "runtime-tokio-rustls"] }
{%- elif backend.database == 'sled' %}
sled = "0.34"
{%- endif %}
{%- if 'grpc' in backend.features %}

[build-dependencies]
tonic-prost-build = "0.14"
{%- endif %}
{%- if 'api' in backend.testing %}

[dev-dependencies]
tower = { version = "0.5", features = ["util"] }
{%- endif %}
