[package]
name = "{{ name }}"
version = "0.1.0"
edition = "2024"

[dependencies]
axum = "0.8"
tokio = { version = "1", features = ["full"] }
{%- if spec.WebApp.Backend.database == 'sqlx' %}
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }
{%- elif spec.WebApp.Backend.database == 'diesel' %}
diesel = { version = "2", features = ["postgres"] }
{%- elif spec.WebApp.Backend.database == 'sea-orm' %}
sea-orm = { version = "1", features = ["sqlx-postgres", "runtime-tokio-rustls"] }
{%- elif spec.WebApp.Backend.database == 'sled' %}
sled = "0.34"
{%- endif %}
