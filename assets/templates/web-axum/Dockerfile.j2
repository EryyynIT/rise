FROM rust:1-slim AS builder
WORKDIR /app
{%- if backend.database == 'diesel' %}
# Diesel links against libpq.
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev && rm -rf /var/lib/apt/lists/*
{%- endif %}
{%- if 'grpc' in backend.features %}
# tonic-build compiles proto/hello.proto with protoc at build time.
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
{%- endif %}
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
{%- if backend.database == 'diesel' %}
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*
{%- endif %}
COPY --from=builder /app/target/release/{{ crate_name }} /usr/local/bin/app
EXPOSE 3000
{%- if 'grpc' in backend.features %}
EXPOSE 50051
{%- endif %}
CMD ["app"]
