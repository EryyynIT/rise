{%- if backend.database == 'sqlx' -%}
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}
{%- elif backend.database == 'sqlite' -%}
//! Database connection pool (sqlx + SQLite, embedded — no server needed).

use sqlx::{SqlitePool, sqlite::SqlitePoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable,
/// defaulting to a local file at `data/app.db` (created on first run).
/// The app runs with zero setup — no `.env`, no database server.
pub async fn create_pool() -> Result<SqlitePool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL")
        .unwrap_or_else(|_| "sqlite://data/app.db?mode=rwc".to_owned());
    // `mode=rwc` creates the database file, but not its parent directory.
    if let Some(directory) = database_url
        .strip_prefix("sqlite://")
        // sqlx also accepts the short `sqlite:path` form.
        .or_else(|| database_url.strip_prefix("sqlite:"))
        .and_then(|rest| rest.split('?').next())
        .and_then(|path| std::path::Path::new(path).parent())
        .filter(|parent| !parent.as_os_str().is_empty())
    {
        std::fs::create_dir_all(directory).expect("create the database directory");
    }
    SqlitePoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}
{%- elif backend.database == 'sea-orm' -%}
//! Database connection (SeaORM + Postgres).

use sea_orm::{Database, DatabaseConnection, DbErr};

/// Connect to Postgres using the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Add entities under `src/entities/` and use the connection from your
/// handlers to run queries.
pub async fn connect() -> Result<DatabaseConnection, DbErr> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    Database::connect(&database_url).await
}
{%- elif backend.database == 'diesel' -%}
//! Database connection pool (Diesel + r2d2 + Postgres).

use diesel::{
    PgConnection,
    r2d2::{ConnectionManager, Pool},
};

/// Synchronous Diesel connections, pooled for use from async handlers.
pub type DbPool = Pool<ConnectionManager<PgConnection>>;

/// Build the pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// The pool is lazy — it opens connections on first use — so the app
/// starts without a live database. Diesel is a blocking ORM: run queries
/// inside `tokio::task::spawn_blocking` (axum) or `web::block` (actix-web).
pub fn create_pool() -> DbPool {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let manager = ConnectionManager::<PgConnection>::new(database_url);
    Pool::builder()
        .max_size(5)
        .build(manager)
        .expect("failed to build the database pool")
}
{%- elif backend.database == 'sled' -%}
//! Embedded key-value storage (sled).

use sled::Db;

/// Open the embedded database at `DB_PATH` (defaults to a local `data/`
/// directory, created on first run).
pub fn open() -> Result<Db, sled::Error> {
    let path = std::env::var("DB_PATH").unwrap_or_else(|_| "data".to_owned());
    sled::open(path)
}
{%- endif %}
