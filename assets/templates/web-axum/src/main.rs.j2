use axum::{Router, routing::get};
{%- if 'web-sockets' in backend.features %}
use axum::{
    extract::ws::{Message, WebSocket, WebSocketUpgrade},
    response::Response,
};
{%- endif %}
{%- if frontend and frontend != 'yew' %}
use axum::{
    http::StatusCode,
    response::Html,
};
{%- endif %}
{%- if frontend == 'yew' %}
use tower_http::services::ServeDir;
{%- endif %}
{%- if frontend == 'askama' %}
use askama::Template;
{%- elif frontend == 'tera' %}
use std::sync::LazyLock;
use tera::{Context, Tera};
{%- elif frontend == 'minijinja' %}
use minijinja::{Environment, context};
use std::sync::LazyLock;
{%- elif frontend == 'handlebars' %}
use handlebars::Handlebars;
use serde_json::json;
use std::sync::LazyLock;
{%- endif %}
{%- if backend.database in ['sqlx', 'sea-orm'] %}

mod db;
{%- endif %}

#[tokio::main]
async fn main() {
{%- if frontend == 'yew' %}
    let app = Router::new().route("/api/hello", get(hello));
{%- else %}
    let app = Router::new().route("/", get(root));
{%- endif %}
{%- if 'web-sockets' in backend.features %}
    let app = app.route("/ws", get(ws_handler));
{%- endif %}
{%- if backend.database == 'sqlx' %}
    let pool = db::create_pool().await.expect("failed to connect to database");
    let app = app.with_state(pool);
{%- elif backend.database == 'sea-orm' %}
    let conn = db::connect().await.expect("failed to connect to database");
    let app = app.with_state(conn);
{%- endif %}
{%- if frontend == 'yew' %}
    // Serve the WASM bundle built by trunk (`frontend/dist`) next to the API.
    let app = app.fallback_service(ServeDir::new("frontend/dist"));
{%- endif %}

    let listener = tokio::net::TcpListener::bind("0.0.0.0:3000")
        .await
        .expect("failed to bind port 3000");

    println!("listening on http://localhost:3000");
    axum::serve(listener, app).await.expect("server error");
}
{%- if frontend == 'askama' %}

/// Home page: rendered from `templates/index.html` at compile time.
#[derive(Template)]
#[template(path = "index.html")]
struct IndexTemplate {
    name: String,
}

async fn root() -> Result<Html<String>, (StatusCode, String)> {
    let template = IndexTemplate {
        name: "{{ name }}".to_owned(),
    };
    template.render().map(Html).map_err(internal_error)
}

fn internal_error(err: impl std::fmt::Display) -> (StatusCode, String) {
    (StatusCode::INTERNAL_SERVER_ERROR, err.to_string())
}
{%- elif frontend == 'tera' %}

/// Templates are embedded into the binary, so the app runs from any
/// working directory (including the slim Docker image).
static TEMPLATES: LazyLock<Tera> = LazyLock::new(|| {
    let mut tera = Tera::default();
    tera.add_raw_template("index.html", include_str!("../templates/index.html"))
        .expect("failed to compile template");
    tera
});

async fn root() -> Result<Html<String>, (StatusCode, String)> {
    let mut context = Context::new();
    context.insert("name", "{{ name }}");
    TEMPLATES
        .render("index.html", &context)
        .map(Html)
        .map_err(internal_error)
}

fn internal_error(err: impl std::fmt::Display) -> (StatusCode, String) {
    (StatusCode::INTERNAL_SERVER_ERROR, err.to_string())
}
{%- elif frontend == 'minijinja' %}

/// Templates are embedded into the binary, so the app runs from any
/// working directory (including the slim Docker image).
static TEMPLATES: LazyLock<Environment<'static>> = LazyLock::new(|| {
    let mut env = Environment::new();
    env.add_template("index.html", include_str!("../templates/index.html"))
        .expect("failed to compile template");
    env
});

async fn root() -> Result<Html<String>, (StatusCode, String)> {
    let template = TEMPLATES.get_template("index.html").map_err(internal_error)?;
    template
        .render(context! { name => "{{ name }}" })
        .map(Html)
        .map_err(internal_error)
}

fn internal_error(err: impl std::fmt::Display) -> (StatusCode, String) {
    (StatusCode::INTERNAL_SERVER_ERROR, err.to_string())
}
{%- elif frontend == 'handlebars' %}

/// Templates are embedded into the binary, so the app runs from any
/// working directory (including the slim Docker image).
static TEMPLATES: LazyLock<Handlebars<'static>> = LazyLock::new(|| {
    let mut handlebars = Handlebars::new();
    handlebars
        .register_template_string("index", include_str!("../templates/index.hbs"))
        .expect("failed to compile template");
    handlebars
});

async fn root() -> Result<Html<String>, (StatusCode, String)> {
    TEMPLATES
        .render("index", &json!({ "name": "{{ name }}" }))
        .map(Html)
        .map_err(internal_error)
}

fn internal_error(err: impl std::fmt::Display) -> (StatusCode, String) {
    (StatusCode::INTERNAL_SERVER_ERROR, err.to_string())
}
