use axum::{Router, routing::get};
{%- if 'web-sockets' in backend.features %}
use axum::{
    extract::ws::{Message, WebSocket, WebSocketUpgrade},
    response::Response,
};
{%- endif %}
{%- if backend.database == 'sqlx' %}

mod db;
{%- endif %}

#[tokio::main]
async fn main() {
    let app = Router::new().route("/", get(root));
{%- if 'web-sockets' in backend.features %}
    let app = app.route("/ws", get(ws_handler));
{%- endif %}
{%- if backend.database == 'sqlx' %}
    let pool = db::create_pool().await.expect("failed to connect to database");
    let app = app.with_state(pool);
{%- endif %}

    let listener = tokio::net::TcpListener::bind("0.0.0.0:3000")
        .await
        .expect("failed to bind port 3000");

    println!("listening on http://localhost:3000");
    axum::serve(listener, app).await.expect("server error");
}

async fn root() -> &'static str {
    "Hello from {{ name }}!"
}
{%- if 'web-sockets' in backend.features %}

/// WebSocket echo endpoint: sends every text message back.
async fn ws_handler(ws: WebSocketUpgrade) -> Response {
    ws.on_upgrade(handle_socket)
}

async fn handle_socket(mut socket: WebSocket) {
    while let Some(Ok(Message::Text(text))) = socket.recv().await {
        if socket.send(Message::Text(text)).await.is_err() {
            break;
        }
    }
}
{%- endif %}
{%- if 'api' in backend.testing %}

#[cfg(test)]
mod tests {
    use super::*;
    use axum::{
        body::Body,
        http::{Request, StatusCode},
    };
    use tower::ServiceExt;

    #[tokio::test]
    async fn root_says_hello() {
        let app = Router::new().route("/", get(root));
        let response = app
            .oneshot(Request::get("/").body(Body::empty()).expect("request"))
            .await
            .expect("response");
        assert_eq!(response.status(), StatusCode::OK);
    }
}
{%- endif %}
{%- if 'sqlx' in backend.testing and backend.database == 'sqlx' %}

#[cfg(test)]
mod db_tests {
    #[tokio::test]
    #[ignore = "needs a running Postgres (set DATABASE_URL)"]
    async fn pool_connects() {
        let pool = crate::db::create_pool().await.expect("connect");
        let row: (i64,) = sqlx::query_as("SELECT 1")
            .fetch_one(&pool)
            .await
            .expect("query");
        assert_eq!(row.0, 1);
    }
}
