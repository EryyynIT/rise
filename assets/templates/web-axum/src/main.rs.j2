#[cfg(test)]
mod tests {
    use super::*;
    use axum::{
        body::Body,
        http::{Request, StatusCode},
    };
    use tower::ServiceExt;

    #[tokio::test]
    async fn root_says_hello() {
{%- if frontend == 'yew' %}
        let app = Router::new().route("/api/hello", get(hello));
{%- else %}
        let app = Router::new().route("/", get(root));
{%- endif %}
        let response = app
            .oneshot(Request::get({% if frontend == 'yew' %}"/api/hello"{% else %}"/"{% endif %}).body(Body::empty()).expect("request"))
            .await
            .expect("response");
        assert_eq!(response.status(), StatusCode::OK);
    }
}
