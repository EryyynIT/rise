#[cfg(feature = "ssr")]
#[actix_web::main]
async fn main() -> std::io::Result<()> {
    use actix_files::Files;
    use actix_web::{App, HttpServer};
{%- if 'rate-limiting' in backend.features %}
    use actix_governor::{Governor, GovernorConfigBuilder};
{%- endif %}
{%- if 'cors' in backend.features %}
    use actix_cors::Cors;
{%- endif %}
    use leptos::config::get_configuration;
    use leptos::prelude::*;
    use leptos_actix::{LeptosRoutes, generate_route_list};
    use leptos_meta::MetaTags;
    use {{ crate_ident }}::app::*;
    use {{ crate_ident }}::db;

    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();

    let conf = get_configuration(None).expect("failed to load leptos configuration");
    let addr = conf.leptos_options.site_addr;
{%- if 'rate-limiting' in backend.features %}
    // Rate limit requests per client IP. The burst must fit a leptos page
    // load (HTML + JS + WASM + CSS + favicon) with room for server
    // function calls, then refills at two requests per second.
    let governor_conf = GovernorConfigBuilder::default()
        .requests_per_second(2)
        .burst_size(50)
        .finish()
        .expect("valid rate limiter configuration");
    // Governor's storage grows unboundedly without periodic cleanup.
    let limiter = governor_conf.limiter();
    actix_web::rt::spawn(async move {
        loop {
            actix_web::rt::time::sleep(std::time::Duration::from_secs(60)).await;
            limiter.retain_recent();
        }
    });
{%- endif %}
{%- if 'graph-ql' in backend.features %}
    let schema = Schema::build(QueryRoot, EmptyMutation, EmptySubscription).finish();
{%- endif %}

{%- if backend.database == 'sqlx' %}
    let db = db::create_pool().await.expect("failed to connect to database");
{%- elif backend.database == 'sea-orm' %}
    let db = db::connect().await.expect("failed to connect to database");
{%- elif backend.database == 'diesel' %}
    let db = db::create_pool();
{%- elif backend.database == 'sled' %}
    let db = db::open().expect("failed to open the database");
{%- endif %}

{%- if 'grpc' in backend.features %}
    // The gRPC API runs on its own port, next to the HTTP server.
    actix_web::rt::spawn(async {
        if let Err(err) = grpc::serve().await {
            eprintln!("gRPC server error: {err}");
        }
    });
{%- endif %}
    HttpServer::new(move || {
        // Generate the list of routes in your Leptos app.
        let routes = generate_route_list(App);
        let leptos_options = &conf.leptos_options;
        let site_root = leptos_options.site_root.to_string();
        // The database handle is provided through the request context:
        // server functions and SSR handlers read it with `use_context`
        // (see `database_status` in app.rs).
        let db = db.clone();

        println!("listening on http://{}", &addr);

        App::new()
{%- if 'rate-limiting' in backend.features %}
            .wrap(Governor::new(&governor_conf))
{%- endif %}
{%- if 'cors' in backend.features %}
            // Answer cross-origin requests (and preflights) from any
            // origin. Restrict this to your frontend's origin before
            // deploying.
            .wrap(Cors::permissive())
{%- endif %}
            // Serve the compiled JS/WASM/CSS bundle.
            .service(Files::new("/pkg", format!("{site_root}/pkg")))
{%- if 'web-sockets' in backend.features %}
            // WebSocket echo endpoint, next to the leptos routes.
            .service(ws)
{%- endif %}
{%- if 'graph-ql' in backend.features %}
            // GraphQL endpoint and IDE; the schema is its own app_data,
            // independent of the leptos request context.
            .service(graphiql)
            .service(graphql)
            .app_data(actix_web::web::Data::new(schema.clone()))
{%- endif %}
            .leptos_routes_with_context(routes, move || provide_context(db.clone()), {
                let leptos_options = leptos_options.clone();
                move || {
                    view! {
                        <!DOCTYPE html>
                        <html lang="en">
                            <head>
                                <meta charset="utf-8"/>
                                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                                <AutoReload options=leptos_options.clone() />
                                <HydrationScripts options=leptos_options.clone()/>
                                <MetaTags/>
                            </head>
                            <body>
                                <App/>
                            </body>
                        </html>
                    }
                }
            })
            .app_data(actix_web::web::Data::new(leptos_options.to_owned()))
    })
    .bind(&addr)?
    .run()
    .await
}

#[cfg(not(feature = "ssr"))]
pub fn main() {
    // No client-side main: the browser entry point is `hydrate` in lib.rs.
}
{%- if 'graph-ql' in backend.features %}

/// The GraphQL schema: one `hello` field to get started.
#[cfg(feature = "ssr")]
struct QueryRoot;

#[cfg(feature = "ssr")]
#[Object]
impl QueryRoot {
    async fn hello(&self) -> &str {
        "Hello from {{ name }}!"
    }
}

#[cfg(feature = "ssr")]
type AppSchema = Schema<QueryRoot, EmptyMutation, EmptySubscription>;

/// Interactive GraphQL IDE on GET /graphql.
#[cfg(feature = "ssr")]
#[get("/graphql")]
async fn graphiql() -> impl actix_web::Responder {
    actix_web::HttpResponse::Ok()
        .content_type("text/html; charset=utf-8")
        .body(GraphiQLSource::build().endpoint("/graphql").finish())
}

/// GraphQL endpoint on POST /graphql.
#[cfg(feature = "ssr")]
#[post("/graphql")]
async fn graphql(schema: web::Data<AppSchema>, request: GraphQLRequest) -> GraphQLResponse {
    schema.execute(request.into_inner()).await.into()
}
{%- endif %}
{%- if 'web-sockets' in backend.features %}

/// WebSocket echo endpoint: sends every text message back.
#[cfg(feature = "ssr")]
#[actix_web::get("/ws")]
async fn ws(
    req: actix_web::HttpRequest,
    body: actix_web::web::Payload,
) -> actix_web::Result<actix_web::HttpResponse> {
    let (response, mut session, mut msg_stream) = actix_ws::handle(&req, body)?;
    actix_web::rt::spawn(async move {
        while let Some(Ok(actix_ws::Message::Text(text))) = msg_stream.recv().await {
            if session.text(text).await.is_err() {
                break;
            }
        }
    });
    Ok(response)
}
