{%- if 'sqlx' in backend.testing and backend.database == 'sqlx' %}

#[cfg(all(test, feature = "ssr"))]
mod db_tests {
    /// Exercises the pool from `src/db.rs`. Run with
    /// `cargo test --features ssr -- --ignored` against a live database.
    #[actix_web::test]
    #[ignore = "needs a running Postgres (set DATABASE_URL)"]
    async fn pool_connects() {
        let pool = {{ crate_ident }}::db::create_pool().await.expect("connect");
        let row: (i64,) = sqlx::query_as("SELECT 1")
            .fetch_one(&pool)
            .await
            .expect("query");
        assert_eq!(row.0, 1);
    }
}
