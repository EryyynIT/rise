#[cfg(feature = "ssr")]
#[tokio::main]
async fn main() {
    use axum::Router;
{%- if 'web-sockets' in backend.features or 'graph-ql' in backend.features %}
    use axum::routing::get;
{%- endif %}
{%- if 'rate-limiting' in backend.features %}
    use std::net::SocketAddr;
    use tower_governor::{GovernorLayer, governor::GovernorConfigBuilder};
{%- endif %}
    use leptos::logging::log;
    use leptos::prelude::*;
    use leptos_axum::{LeptosRoutes, generate_route_list};
    use {{ crate_ident }}::app::*;
    use {{ crate_ident }}::db;

    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();

    let conf = get_configuration(None).expect("failed to load leptos configuration");
    let addr = conf.leptos_options.site_addr;
    let leptos_options = conf.leptos_options;
    // Generate the list of routes in your Leptos app.
    let routes = generate_route_list(App);

{%- if backend.database == 'sqlx' %}
    let db = db::create_pool().await.expect("failed to connect to database");
{%- elif backend.database == 'sea-orm' %}
    let db = db::connect().await.expect("failed to connect to database");
{%- elif backend.database == 'diesel' %}
    let db = db::create_pool();
{%- elif backend.database == 'sled' %}
    let db = db::open().expect("failed to open the database");
{%- endif %}
{%- if 'graph-ql' in backend.features %}
    // The database handle is shared with the GraphQL resolvers as context data.
    let schema = Schema::build(QueryRoot, EmptyMutation, EmptySubscription)
        .data(db.clone())
        .finish();
{%- endif %}

    let app = Router::new()
{%- if 'web-sockets' in backend.features %}
        // WebSocket echo endpoint, next to the leptos routes.
        .route("/ws", get(ws_handler))
{%- endif %}
{%- if 'graph-ql' in backend.features %}
        // GraphQL endpoint and IDE; the schema travels as a request
        // extension (the router state is already LeptosOptions).
        .route("/graphql", get(graphiql).post(graphql))
        .layer(Extension(schema))
{%- endif %}
        // The database handle is provided through the request context:
        // server functions and SSR handlers read it with `use_context`
        // (see `database_status` in app.rs).
        .leptos_routes_with_context(
            &leptos_options,
            routes,
            move || provide_context(db.clone()),
            {
                let leptos_options = leptos_options.clone();
                move || shell(leptos_options.clone())
            },
        )
        .fallback(leptos_axum::file_and_error_handler(shell))
        .with_state(leptos_options);
{%- if 'rate-limiting' in backend.features %}

    // Rate limit requests per client IP. The burst must fit a leptos page
    // load (HTML + JS + WASM + CSS + favicon) with room for server
    // function calls, then refills at one request every 2 seconds.
    let governor_conf = GovernorConfigBuilder::default()
        .per_second(2)
        .burst_size(50)
        .finish()
        .expect("valid rate limiter configuration");
    // Governor's storage grows unboundedly without periodic cleanup.
    let limiter = governor_conf.limiter().clone();
    tokio::spawn(async move {
        loop {
            tokio::time::sleep(std::time::Duration::from_secs(60)).await;
            limiter.retain_recent();
        }
    });
    let app = app.layer(GovernorLayer::new(governor_conf));
{%- endif %}

    log!("listening on http://{}", &addr);
{%- if 'grpc' in backend.features %}
    // The gRPC API runs on its own port, next to the HTTP server.
    tokio::spawn(async {
        if let Err(err) = grpc::serve().await {
            eprintln!("gRPC server error: {err}");
        }
    });
{%- endif %}
    let listener = tokio::net::TcpListener::bind(&addr)
        .await
        .expect("failed to bind");
{%- if 'rate-limiting' in backend.features %}
    // The per-IP rate limiter needs the peer address of each connection.
    axum::serve(listener, app.into_make_service_with_connect_info::<SocketAddr>())
        .await
        .expect("failed to serve");
{%- else %}
    axum::serve(listener, app.into_make_service())
        .await
        .expect("failed to serve");
{%- endif %}
}

#[cfg(not(feature = "ssr"))]
pub fn main() {
    // No client-side main: the browser entry point is `hydrate` in lib.rs.
}
{%- if 'graph-ql' in backend.features %}

/// The GraphQL schema: one `hello` field to get started.
#[cfg(feature = "ssr")]
struct QueryRoot;

#[cfg(feature = "ssr")]
#[Object]
impl QueryRoot {
    async fn hello(&self) -> &str {
        "Hello from {{ name }}!"
    }
}

#[cfg(feature = "ssr")]
type AppSchema = Schema<QueryRoot, EmptyMutation, EmptySubscription>;

/// Interactive GraphQL IDE on GET /graphql.
#[cfg(feature = "ssr")]
async fn graphiql() -> Html<String> {
    Html(GraphiQLSource::build().endpoint("/graphql").finish())
}

/// GraphQL endpoint on POST /graphql.
#[cfg(feature = "ssr")]
async fn graphql(Extension(schema): Extension<AppSchema>, request: GraphQLRequest) -> GraphQLResponse {
    schema.execute(request.into_inner()).await.into()
}
{%- endif %}
{%- if 'web-sockets' in backend.features %}

/// WebSocket echo endpoint: sends every text message back.
#[cfg(feature = "ssr")]
async fn ws_handler(ws: WebSocketUpgrade) -> Response {
    ws.on_upgrade(handle_socket)
}

#[cfg(feature = "ssr")]
async fn handle_socket(mut socket: WebSocket) {
    while let Some(Ok(Message::Text(text))) = socket.recv().await {
        if socket.send(Message::Text(text)).await.is_err() {
            break;
        }
    }
}
