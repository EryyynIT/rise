{%- if 'auth' in backend.features -%}
# Signs the JWTs issued by /auth/login. Change this in production.
JWT_SECRET=change-me-in-production
{% endif -%}
{%- if backend.database == 'sled' -%}
DB_PATH=data
{%- else -%}
DATABASE_URL=postgres://postgres:postgres@localhost/{{ name | replace("-", "_") }}
{%- endif %}
