{%- if 'sqlx' in backend.testing and backend.database == 'sqlite' %}

#[cfg(test)]
mod db_tests {
    #[test]
    fn pool_connects() {
        // SQLite runs in-process: the pool test is live, no server needed.
        // rocket's own tokio runtime, so the generated project needs no
        // direct tokio dependency.
        rocket::tokio::runtime::Runtime::new()
            .expect("tokio runtime")
            .block_on(async {
                let pool = sqlx::SqlitePool::connect("sqlite::memory:")
                    .await
                    .expect("connect");
                let row: (i64,) = sqlx::query_as("SELECT 1")
                    .fetch_one(&pool)
                    .await
                    .expect("query");
                assert_eq!(row.0, 1);
            });
    }
}
