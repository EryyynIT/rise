/// The GraphQL schema type: one `hello` query to get started.
type AppSchema = Schema<QueryRoot, EmptyMutation, EmptySubscription>;
{%- endif %}

#[rocket::main]
async fn main() -> Result<(), rocket::Error> {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
{%- if backend.database == 'sqlx' or backend.database == 'sqlite' %}
    let db = db::create_pool().await.expect("failed to connect to database");
{%- elif backend.database == 'sea-orm' %}
    let db = db::connect().await.expect("failed to connect to database");
{%- elif backend.database == 'diesel' %}
    let db = db::create_pool();
{%- elif backend.database == 'sled' %}
    let db = db::open().expect("failed to open the database");
{%- endif %}
{%- if 'auth' in backend.features %}
    // Fail at startup, not on the first request, when JWT_SECRET is unset.
    auth::check_secret();
{%- if backend.database != 'sled' %}
    // The users table behind /auth/register and /auth/login.
{%- if backend.database == 'diesel' %}
    auth::migrate(&db);
{%- else %}
    auth::migrate(&db).await;
{%- endif %}
{%- endif %}
{%- endif %}
{%- if 'graph-ql' in backend.features %}
    // The database handle is shared with the GraphQL resolvers as context data.
    let schema = Schema::build(QueryRoot, EmptyMutation, EmptySubscription)
        .data(db.clone())
        .finish();
{%- endif %}
    // Listen on 0.0.0.0:3000 like every other backend rise generates;
    // rocket's own defaults are 127.0.0.1:8000.
    let config = rocket::Config {
        address: std::net::Ipv4Addr::UNSPECIFIED.into(),
        port: 3000,
        ..Default::default()
    };
    let rocket = rocket::custom(config)
        .manage(db)
{%- if 'graph-ql' in backend.features %}
        .manage(schema)
{%- endif %}
{%- if frontend == 'yew' %}
        .mount("/", routes![hello])
        // Serve the WASM bundle built by trunk (`frontend/dist`) next to the API.
        .mount("/", FileServer::from("frontend/dist"))
        .mount("/", routes![spa_fallback]);
{%- else %}
        .mount("/", routes![root]);
{%- endif %}
{%- if 'web-sockets' in backend.features %}
    let rocket = rocket.mount("/", routes![ws_echo]);
{%- endif %}
{%- if 'graph-ql' in backend.features %}
    let rocket = rocket.mount("/", routes![graphiql, graphql_query, graphql_request]);
{%- endif %}
{%- if 'auth' in backend.features %}
    // JWT auth: /auth/register, /auth/login and a protected /api/me.
    let rocket = rocket.mount("/", routes![auth::register, auth::login, auth::me]);
{%- endif %}
{%- if 'cors' in backend.features %}
    // Answer cross-origin requests (and preflights) from any origin.
    // Restrict this to your frontend's origin before deploying.
    let cors = CorsOptions::default()
        .to_cors()
        .expect("valid CORS configuration");
    let rocket = rocket.attach(cors);
{%- endif %}
{%- if 'rate-limiting' in backend.features %}
    let rocket = rocket.attach(rate_limit::RateLimit::new());
{%- endif %}
{%- if 'grpc' in backend.features %}
    // The gRPC API runs on its own port, next to the HTTP server. `main`
    // already runs inside rocket's tokio runtime (`#[rocket::main]`).
    rocket::tokio::spawn(async {
        if let Err(err) = grpc::serve().await {
            eprintln!("gRPC server error: {err}");
        }
    });
{%- endif %}

    println!("listening on http://localhost:3000");
    rocket.launch().await?;
    Ok(())
}
{%- if frontend == 'askama' %}

/// Home page: rendered from `templates/index.html` at compile time.
#[derive(Template)]
#[template(path = "index.html")]
struct IndexTemplate {
    name: String,
}

#[rocket::get("/")]
fn root() -> Result<RawHtml<String>, Status> {
    let template = IndexTemplate {
        name: "{{ name }}".to_owned(),
    };
    template
        .render()
        .map(RawHtml)
        .map_err(|_| Status::InternalServerError)
}
{%- elif frontend == 'tera' %}

/// Templates are embedded into the binary, so the app runs from any
/// working directory (including the slim Docker image).
static TEMPLATES: LazyLock<Tera> = LazyLock::new(|| {
    let mut tera = Tera::default();
    tera.add_raw_template("index.html", include_str!("../templates/index.html"))
        .expect("failed to compile template");
    tera
});

#[rocket::get("/")]
fn root() -> Result<RawHtml<String>, Status> {
    let mut context = Context::new();
    context.insert("name", "{{ name }}");
    TEMPLATES
        .render("index.html", &context)
        .map(RawHtml)
        .map_err(|_| Status::InternalServerError)
}
{%- elif frontend == 'minijinja' %}

/// Templates are embedded into the binary, so the app runs from any
/// working directory (including the slim Docker image).
static TEMPLATES: LazyLock<Environment<'static>> = LazyLock::new(|| {
    let mut env = Environment::new();
    env.add_template("index.html", include_str!("../templates/index.html"))
        .expect("failed to compile template");
    env
});

#[rocket::get("/")]
fn root() -> Result<RawHtml<String>, Status> {
    TEMPLATES
        .get_template("index.html")
        .and_then(|template| template.render(context! { name => "{{ name }}" }))
        .map(RawHtml)
        .map_err(|_| Status::InternalServerError)
}
{%- elif frontend == 'handlebars' %}

/// Templates are embedded into the binary, so the app runs from any
/// working directory (including the slim Docker image).
static TEMPLATES: LazyLock<Handlebars<'static>> = LazyLock::new(|| {
    let mut handlebars = Handlebars::new();
    handlebars
        .register_template_string("index", include_str!("../templates/index.hbs"))
        .expect("failed to compile template");
    handlebars
});

#[rocket::get("/")]
fn root() -> Result<RawHtml<String>, Status> {
    TEMPLATES
        .render("index", &json!({ "name": "{{ name }}" }))
        .map(RawHtml)
        .map_err(|_| Status::InternalServerError)
}
{%- elif frontend == 'yew' %}

/// Greeting for the WASM frontend.
#[rocket::get("/api/hello")]
fn hello() -> &'static str {
    "Hello from {{ name }}!"
}

/// SPA fallback: anything that is neither an API route nor a file in
/// `frontend/dist` gets the frontend's `index.html`. The rank keeps it
/// behind the file server's routes (rank 10).
#[rocket::get("/<_path..>", rank = 20)]
async fn spa_fallback(_path: PathBuf) -> Option<NamedFile> {
    NamedFile::open("frontend/dist/index.html").await.ok()
}
{%- else %}

#[rocket::get("/")]
fn root() -> &'static str {
    "Hello from {{ name }}!"
}
