=== src/main.rs ===
use clap::Parser;

/// sample-app — command-line application.
#[derive(Parser)]
#[command(version, about)]
struct Cli {
    /// Who to greet.
    #[arg(default_value = "world")]
    name: String,
}

fn main() {
    let cli = Cli::parse();
    println!("Hello, {}!", cli.name);
}
