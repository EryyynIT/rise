=== .dockerignore ===
# Keep the build context small.
.git
/target
/dist

=== .gitignore ===
/target
/dist

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
yew = { version = "0.22", features = ["csr"] }

=== Dockerfile ===
# Build the WASM bundle with trunk.
FROM rust:1-slim AS builder
RUN cargo install --locked trunk && rustup target add wasm32-unknown-unknown
WORKDIR /app
COPY . .
RUN trunk build --release

# Serve the static bundle.
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80

=== README.md ===
# sample-app

Yew single-page app (WASM) generated by [rise](https://github.com/EryyynIT/rise).

## Prerequisites

```sh
rustup target add wasm32-unknown-unknown
cargo install trunk
```

`rise doctor` checks these for you.

## Run

```sh
trunk serve
```

The SPA is on http://localhost:8080.

## Docker

```sh
docker build -t sample-app .
docker run -p 8080:80 sample-app
```

nginx serves the built bundle.

=== index.html ===
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>sample-app</title>
</head>
<body>
    <link data-trunk rel="rust" href="Cargo.toml">
</body>
</html>

=== src/main.rs ===
use yew::prelude::*;

/// Root component.
#[function_component(App)]
fn app() -> Html {
    html! { <h1>{ "Hello from sample-app!" }</h1> }
}

fn main() {
    yew::Renderer::<App>::new().render();
}
