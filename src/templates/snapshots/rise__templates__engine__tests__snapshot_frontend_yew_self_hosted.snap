---
source: src/templates/engine.rs
expression: "snapshot_output(&frontend_spec(Frontend::Yew, Deployment::SelfHosted))"
---
=== .gitignore ===
/target
/dist

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
yew = { version = "0.22", features = ["csr"] }

=== index.html ===
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>sample-app</title>
</head>
<body>
    <link data-trunk rel="rust" href="Cargo.toml">
</body>
</html>

=== src/main.rs ===
use yew::prelude::*;

/// Root component.
#[function_component(App)]
fn app() -> Html {
    html! { <h1>{ "Hello from sample-app!" }</h1> }
}

fn main() {
    yew::Renderer::<App>::new().render();
}
