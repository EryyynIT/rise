=== README.md ===
# sample-app

A tiny macroquad game generated by [rise](https://github.com/EryyynIT/rise):
move with arrows/WASD, collect the coins, ESC quits.

## Run

```sh
cargo run
```

=== src/main.rs ===
//! sample-app — a tiny "collect the coins" game on macroquad.

use macroquad::prelude::*;

const PLAYER_SPEED: f32 = 300.0;
const PLAYER_RADIUS: f32 = 20.0;
const COIN_RADIUS: f32 = 12.0;
const COIN_SPAWN_SECONDS: f32 = 0.8;
const MAX_COINS: usize = 8;

fn window_conf() -> Conf {
    Conf {
        window_title: "sample-app".to_owned(),
        window_width: 800,
        window_height: 600,
        // Fixed size: the HUD layout and the spawn/clamp math assume 800x600.
        window_resizable: false,
        ..Default::default()
    }
}

struct Coin {
    position: Vec2,
}

#[macroquad::main(window_conf)]
async fn main() {
    let mut player = vec2(screen_width() / 2.0, screen_height() / 2.0);
    let mut coins: Vec<Coin> = Vec::new();
    let mut score = 0u32;
    let mut spawn_timer = 0.0;

    loop {
        let dt = get_frame_time();

        // Move with the arrow keys or WASD, clamped to the window.
        let mut direction = Vec2::ZERO;
        if is_key_down(KeyCode::Left) || is_key_down(KeyCode::A) {
            direction.x -= 1.0;
        }
        if is_key_down(KeyCode::Right) || is_key_down(KeyCode::D) {
            direction.x += 1.0;
        }
        if is_key_down(KeyCode::Up) || is_key_down(KeyCode::W) {
            direction.y -= 1.0;
        }
        if is_key_down(KeyCode::Down) || is_key_down(KeyCode::S) {
            direction.y += 1.0;
        }
        if direction != Vec2::ZERO {
            player += direction.normalize() * PLAYER_SPEED * dt;
        }
        player.x = player.x.clamp(PLAYER_RADIUS, screen_width() - PLAYER_RADIUS);
        player.y = player.y.clamp(PLAYER_RADIUS, screen_height() - PLAYER_RADIUS);

        // Spawn new coins on a timer. The clock pauses while the coin cap
        // is full, so collecting one never spawns its replacement at once.
        if coins.len() < MAX_COINS {
            spawn_timer -= dt;
            if spawn_timer <= 0.0 {
                coins.push(Coin {
                    position: vec2(
                        rand::gen_range(COIN_RADIUS, screen_width() - COIN_RADIUS),
                        rand::gen_range(COIN_RADIUS, screen_height() - COIN_RADIUS),
                    ),
                });
                spawn_timer = COIN_SPAWN_SECONDS;
            }
        }

        // Collect the coins the player touches.
        coins.retain(|coin| {
            let collected = coin.position.distance(player) < PLAYER_RADIUS + COIN_RADIUS;
            if collected {
                score += 1;
            }
            !collected
        });

        clear_background(BLACK);
        for coin in &coins {
            draw_circle(coin.position.x, coin.position.y, COIN_RADIUS, GOLD);
        }
        draw_circle(player.x, player.y, PLAYER_RADIUS, SKYBLUE);
        draw_text(&format!("score: {score}"), 20.0, 40.0, 32.0, WHITE);
        draw_text(
            "arrows / WASD to move, ESC to quit",
            20.0,
            screen_height() - 20.0,
            24.0,
            GRAY,
        );

        next_frame().await;
    }
}
