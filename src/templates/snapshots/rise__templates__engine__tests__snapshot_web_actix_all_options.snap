=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
actix-web = "4"
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
actix-ws = "0.3"
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== README.md ===
# sample-app

actix web app generated by [rise](https://github.com/EryyynIT/rise).

Stack: actix + sqlx.

## Prerequisites

- Rust — https://rustup.rs (`rise doctor` checks this machine)
- a Postgres database — `.env.example` has the URL shape

## Run

```sh
cp .env.example .env  # set DATABASE_URL
cargo run
```

The server listens on http://localhost:3000.
`/ws` is a WebSocket echo endpoint.

## Test

```sh
cargo test
```

Database-backed tests are `#[ignore]`d until you pass a live
`DATABASE_URL` — `cargo test -- --include-ignored`.

## Docker

```sh
docker build -t sample-app .
```

```sh
docker compose up --build  # the app together with its Postgres service
```

=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      # Local-development password; override it when deploying for real.
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      # initdb on a slow disk must not eat into the retry budget.
      start_period: 10s
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

=== src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}

=== src/main.rs ===
use actix_web::{App, HttpServer, Responder, get};
use actix_web::{HttpRequest, HttpResponse};

mod db;

#[get("/")]
async fn root() -> impl Responder {
    "Hello from sample-app!"
}

/// WebSocket echo endpoint: sends every text message back.
#[get("/ws")]
async fn ws(
    req: HttpRequest,
    body: actix_web::web::Payload,
) -> actix_web::Result<HttpResponse> {
    let (response, mut session, mut msg_stream) = actix_ws::handle(&req, body)?;
    actix_web::rt::spawn(async move {
        while let Some(Ok(actix_ws::Message::Text(text))) = msg_stream.recv().await {
            if session.text(text).await.is_err() {
                break;
            }
        }
    });
    Ok(response)
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let pool = db::create_pool().await.expect("failed to connect to database");
    println!("listening on http://localhost:3000");
    HttpServer::new(move || {
        let app = App::new().service(root);
        let app = app.service(ws);
        app.app_data(actix_web::web::Data::new(pool.clone()))
    })
    .bind(("0.0.0.0", 3000))?
    .run()
    .await
}

#[cfg(test)]
mod tests {
    use super::*;
    use actix_web::{App, http::StatusCode, test};

    #[actix_web::test]
    async fn root_says_hello() {
        let app = test::init_service(App::new().service(root)).await;
        let req = test::TestRequest::get().uri("/").to_request();
        let resp = test::call_service(&app, req).await;
        assert_eq!(resp.status(), StatusCode::OK);
    }
}

#[cfg(test)]
mod db_tests {
    #[actix_web::test]
    #[ignore = "needs a running Postgres (set DATABASE_URL)"]
    async fn pool_connects() {
        let pool = crate::db::create_pool().await.expect("connect");
        let row: (i64,) = sqlx::query_as("SELECT 1")
            .fetch_one(&pool)
            .await
            .expect("query");
        assert_eq!(row.0, 1);
    }
}
