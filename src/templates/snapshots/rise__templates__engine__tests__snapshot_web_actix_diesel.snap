DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== .gitignore ===
/target
.env

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
actix-web = "4"
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
diesel = { version = "2", features = ["postgres", "r2d2"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
# Diesel links against libpq.
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== README.md ===
# sample-app

actix web app generated by [rise](https://github.com/EryyynIT/rise).

Stack: actix + diesel.

## Prerequisites

- Rust — https://rustup.rs (`rise doctor` checks this machine)
- a Postgres database — `.env.example` has the URL shape

## Run

```sh
cp .env.example .env  # set DATABASE_URL
cargo run
```

The server listens on http://localhost:3000.

## Test

```sh
cargo test
```

Database-backed tests are `#[ignore]`d until you pass a live
`DATABASE_URL` — `cargo test -- --include-ignored`.

## Docker

```sh
docker build -t sample-app .
```

```sh
docker compose up --build  # the app together with its Postgres service
```

=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      # Local-development password; override it when deploying for real.
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      # initdb on a slow disk must not eat into the retry budget.
      start_period: 10s
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

=== src/db.rs ===
//! Database connection pool (Diesel + r2d2 + Postgres).

use diesel::{
    PgConnection,
    r2d2::{ConnectionManager, Pool},
};

/// Synchronous Diesel connections, pooled for use from async handlers.
pub type DbPool = Pool<ConnectionManager<PgConnection>>;

/// Build the pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// The pool is lazy — it opens connections on first use — so the app
/// starts without a live database. Diesel is a blocking ORM: run queries
/// inside `tokio::task::spawn_blocking` (axum) or `web::block` (actix-web).
pub fn create_pool() -> DbPool {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let manager = ConnectionManager::<PgConnection>::new(database_url);
    Pool::builder()
        .max_size(5)
        .build(manager)
        .expect("failed to build the database pool")
}

=== src/main.rs ===
use actix_web::{App, HttpServer, Responder, get};

mod db;

#[get("/")]
async fn root() -> impl Responder {
    "Hello from sample-app!"
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let pool = db::create_pool();
    println!("listening on http://localhost:3000");
    HttpServer::new(move || {
        let app = App::new().service(root);
        app.app_data(actix_web::web::Data::new(pool.clone()))
    })
    .bind(("0.0.0.0", 3000))?
    .run()
    .await
}
