=== .env.example ===
DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== .gitignore ===
/target
.env

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
actix-web = "4"
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }

[dev-dependencies]
mockall = "0.13"

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}

=== src/main.rs ===
use actix_web::{App, HttpServer, Responder, get};

mod db;

#[get("/")]
async fn root() -> impl Responder {
    "Hello from sample-app!"
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    let pool = db::create_pool().await.expect("failed to connect to database");
    println!("listening on http://localhost:3000");
    HttpServer::new(move || {
        let app = App::new().service(root);
        app.app_data(actix_web::web::Data::new(pool.clone()))
    })
    .bind(("0.0.0.0", 3000))?
    .run()
    .await
}

#[cfg(test)]
mod tests {
    use super::*;
    use actix_web::{App, http::StatusCode, test};

    #[actix_web::test]
    async fn root_says_hello() {
        let app = test::init_service(App::new().service(root)).await;
        let req = test::TestRequest::get().uri("/").to_request();
        let resp = test::call_service(&app, req).await;
        assert_eq!(resp.status(), StatusCode::OK);
    }
}

#[cfg(test)]
mod db_tests {
    #[actix_web::test]
    #[ignore = "needs a running Postgres (set DATABASE_URL)"]
    async fn pool_connects() {
        let pool = crate::db::create_pool().await.expect("connect");
        let row: (i64,) = sqlx::query_as("SELECT 1")
            .fetch_one(&pool)
            .await
            .expect("query");
        assert_eq!(row.0, 1);
    }
}
