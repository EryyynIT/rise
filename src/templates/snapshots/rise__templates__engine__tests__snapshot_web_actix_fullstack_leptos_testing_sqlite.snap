=== .dockerignore ===
# Keep the build context small and secrets out of image layers:
# cargo-leptos output under target/ is rebuilt inside the image.
.git
/target
.env

=== .env.example ===
DATABASE_URL=sqlite://data/app.db?mode=rwc

=== .gitignore ===
/target
.env
/data

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
actix-files = { version = "0.6", optional = true }
actix-web = { version = "4", features = ["macros"], optional = true }
leptos = { version = "0.8" }
leptos_meta = { version = "0.8" }
leptos_actix = { version = "0.8", optional = true }
leptos_router = { version = "0.8" }
console_error_panic_hook = { version = "0.1", optional = true }
wasm-bindgen = { version = "0.2", optional = true }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = { version = "0.15", optional = true }
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "sqlite"], optional = true }

[features]
hydrate = ["leptos/hydrate", "dep:console_error_panic_hook", "dep:wasm-bindgen"]
ssr = [
    "dep:actix-files",
    "dep:actix-web",
    "dep:leptos_actix",
    "dep:dotenvy",
    "dep:sqlx",
    "leptos/ssr",
    "leptos_meta/ssr",
    "leptos_router/ssr",
]

# Size-optimized profile for the WASM bundle in release mode.
[profile.wasm-release]
inherits = "release"
opt-level = "z"
lto = true
codegen-units = 1
panic = "abort"

# cargo-leptos reads this section; every key can be overridden by a
# LEPTOS_* environment variable (see the Dockerfile).
[package.metadata.leptos]
# Name of the JS/WASM/CSS bundle. Defaults to the crate name.
output-name = "sample-app"
# All cargo-leptos output lands here; the server reads files from it.
site-root = "target/site"
# The site-root-relative folder the compiled JS/WASM/CSS is written to.
site-pkg-dir = "pkg"
# Plain CSS (a .scss file would be compiled with dart-sass instead).
style-file = "style/main.css"
# Address the server binds to.
site-addr = "127.0.0.1:3000"
# WebSocket port for automatic reload in DEV.
reload-port = 3001
env = "DEV"
# The binary is built for the server, the library for the browser.
bin-features = ["ssr"]
bin-default-features = false
lib-features = ["hydrate"]
lib-default-features = false
lib-profile-release = "wasm-release"

=== Dockerfile ===
# Build the SSR binary and the WASM bundle with cargo-leptos.
FROM rust:1-slim AS builder
RUN cargo install --locked cargo-leptos && rustup target add wasm32-unknown-unknown
WORKDIR /app
COPY . .
RUN cargo leptos build --release

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /app/target/release/sample-app /usr/local/bin/server
COPY --from=builder /app/target/site /app/site
# The runtime image has no Cargo.toml, so the leptos configuration comes
# from environment variables (they override [package.metadata.leptos]).
ENV LEPTOS_ENV=PROD \
    LEPTOS_SITE_ADDR=0.0.0.0:3000 \
    LEPTOS_SITE_ROOT=/app/site
EXPOSE 3000
CMD ["server"]

=== src/app.rs ===
use leptos::prelude::*;
use leptos_meta::{Stylesheet, Title, provide_meta_context};
use leptos_router::{
    StaticSegment, WildcardSegment,
    components::{Route, Router, Routes},
};

#[component]
pub fn App() -> impl IntoView {
    // Provides context that manages stylesheets, titles, meta tags, etc.
    provide_meta_context();

    view! {
        // injects a stylesheet into the document <head>
        // id=leptos means cargo-leptos will hot-reload this stylesheet
        <Stylesheet id="leptos" href="/pkg/sample-app.css"/>

        // sets the document title
        <Title text="Welcome to Leptos"/>

        // content for this welcome page
        <Router>
            <main>
                <Routes fallback=move || "Not found.">
                    <Route path=StaticSegment("") view=HomePage/>
                    <Route path=WildcardSegment("any") view=NotFound/>
                </Routes>
            </main>
        </Router>
    }
}

/// Renders the home page of your application.
#[component]
fn HomePage() -> impl IntoView {
    // Creates a reactive value to update the button
    let count = RwSignal::new(0);
    let on_click = move |_| *count.write() += 1;
    // Runs on the server during SSR and streams the result to the client.
    let status = OnceResource::new(database_status());

    view! {
        <h1>"Welcome to Leptos!"</h1>
        <button on:click=on_click>"Click Me: " {count}</button>
        <Suspense fallback=|| view! { <p>"Checking the database…"</p> }>
            {move || {
                status.get().map(|result| {
                    view! { <p>"Database: " {result.unwrap_or_else(|e| e.to_string())}</p> }
                })
            }}
        </Suspense>
    }
}

/// Example server function: proves the database wiring works. The
/// connection is provided through the request context (created in
/// `main.rs`, see `src/db.rs` for the type) — replace the query with
/// your own.
#[server]
pub async fn database_status() -> Result<String, ServerFnError> {
    let pool = use_context::<sqlx::SqlitePool>()
        .ok_or_else(|| ServerFnError::new("database pool missing from the request context"))?;
    // Runtime-checked query: the project compiles without a live database.
    sqlx::query_scalar::<_, String>("SELECT 'connected'")
        .fetch_one(&pool)
        .await
        .map_err(|e| ServerFnError::new(format!("database query failed: {e}")))
}

/// 404 - Not Found
#[component]
fn NotFound() -> impl IntoView {
    // set an HTTP status code 404
    // this is feature gated because it can only be done during
    // initial server-side rendering
    // if you navigate to the 404 page subsequently, the status
    // code will not be set because there is not a new HTTP request
    // to the server
    #[cfg(feature = "ssr")]
    {
        // this can be done inline because it's synchronous
        // if it were async, we'd use a server function
        let resp = expect_context::<leptos_actix::ResponseOptions>();
        resp.set_status(actix_web::http::StatusCode::NOT_FOUND);
    }

    view! {
        <h1>"Not Found"</h1>
    }
}

=== src/db.rs ===
//! Database connection pool (sqlx + SQLite, embedded — no server needed).

use sqlx::{SqlitePool, sqlite::SqlitePoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable,
/// defaulting to a local file at `data/app.db` (created on first run).
/// The app runs with zero setup — no `.env`, no database server.
pub async fn create_pool() -> Result<SqlitePool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL")
        .unwrap_or_else(|_| "sqlite://data/app.db?mode=rwc".to_owned());
    // `mode=rwc` creates the database file, but not its parent directory.
    if let Some(directory) = database_url
        .strip_prefix("sqlite://")
        .and_then(|rest| rest.split('?').next())
        .and_then(|path| std::path::Path::new(path).parent())
        .filter(|parent| !parent.as_os_str().is_empty())
    {
        std::fs::create_dir_all(directory).expect("create the database directory");
    }
    SqlitePoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}

=== src/lib.rs ===
pub mod app;
#[cfg(feature = "ssr")]
pub mod db;

#[cfg(feature = "hydrate")]
#[wasm_bindgen::prelude::wasm_bindgen]
pub fn hydrate() {
    use crate::app::*;
    console_error_panic_hook::set_once();
    leptos::mount::hydrate_body(App);
}

=== src/main.rs ===
#[cfg(feature = "ssr")]
#[actix_web::main]
async fn main() -> std::io::Result<()> {
    use actix_files::Files;
    use actix_web::{App, HttpServer};
    use leptos::config::get_configuration;
    use leptos::prelude::*;
    use leptos_actix::{LeptosRoutes, generate_route_list};
    use leptos_meta::MetaTags;
    use sample_app::app::*;
    use sample_app::db;

    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();

    let conf = get_configuration(None).expect("failed to load leptos configuration");
    let addr = conf.leptos_options.site_addr;
    let db = db::create_pool().await.expect("failed to connect to database");
    HttpServer::new(move || {
        // Generate the list of routes in your Leptos app.
        let routes = generate_route_list(App);
        let leptos_options = &conf.leptos_options;
        let site_root = leptos_options.site_root.to_string();
        // The database handle is provided through the request context:
        // server functions and SSR handlers read it with `use_context`
        // (see `database_status` in app.rs).
        let db = db.clone();

        println!("listening on http://{}", &addr);

        App::new()
            // Serve the compiled JS/WASM/CSS bundle.
            .service(Files::new("/pkg", format!("{site_root}/pkg")))
            .leptos_routes_with_context(routes, move || provide_context(db.clone()), {
                let leptos_options = leptos_options.clone();
                move || {
                    view! {
                        <!DOCTYPE html>
                        <html lang="en">
                            <head>
                                <meta charset="utf-8"/>
                                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                                <AutoReload options=leptos_options.clone() />
                                <HydrationScripts options=leptos_options.clone()/>
                                <MetaTags/>
                            </head>
                            <body>
                                <App/>
                            </body>
                        </html>
                    }
                }
            })
            .app_data(actix_web::web::Data::new(leptos_options.to_owned()))
    })
    .bind(&addr)?
    .run()
    .await
}

#[cfg(not(feature = "ssr"))]
pub fn main() {
    // No client-side main: the browser entry point is `hydrate` in lib.rs.
}

#[cfg(all(test, feature = "ssr"))]
mod tests {
    use actix_web::{App, http::StatusCode, test, web::Data};
    use leptos::config::get_configuration;
    use leptos::prelude::*;
    use leptos::server_fn::ServerFn;
    use leptos_actix::{LeptosRoutes, generate_route_list};
    use leptos_meta::MetaTags;
    use sample_app::app::*;

    /// The generated server function answers over HTTP end to end:
    /// routing, the request context and the database handle. Run with
    /// `cargo test --features ssr` (server code is gated on `ssr`).
    #[actix_web::test]
    async fn server_function_answers() {
        // SQLite runs in-process: the test database lives in memory.
        let db = sqlx::SqlitePool::connect("sqlite::memory:")
            .await
            .expect("connect");
        let conf = get_configuration(None).expect("failed to load leptos configuration");
        let leptos_options = conf.leptos_options;
        let routes = generate_route_list(App);
        let app = test::init_service(
            App::new()
                .leptos_routes_with_context(routes, move || provide_context(db.clone()), {
                    let leptos_options = leptos_options.clone();
                    move || {
                        view! {
                            <!DOCTYPE html>
                            <html lang="en">
                                <head>
                                    <meta charset="utf-8"/>
                                    <AutoReload options=leptos_options.clone() />
                                    <HydrationScripts options=leptos_options.clone()/>
                                    <MetaTags/>
                                </head>
                                <body>
                                    <App/>
                                </body>
                            </html>
                        }
                    }
                })
                .app_data(Data::new(leptos_options)),
        )
        .await;
        let request = test::TestRequest::post().uri(DatabaseStatus::url()).to_request();
        let response = test::call_service(&app, request).await;
        assert_eq!(response.status(), StatusCode::OK);
        let body = test::read_body(response).await;
        assert!(String::from_utf8_lossy(&body).contains("connected"));
    }
}

#[cfg(all(test, feature = "ssr"))]
mod db_tests {
    /// SQLite runs in-process: the pool test is live, no server needed.
    #[actix_web::test]
    async fn pool_connects() {
        let pool = sqlx::SqlitePool::connect("sqlite::memory:")
            .await
            .expect("connect");
        let row: (i64,) = sqlx::query_as("SELECT 1")
            .fetch_one(&pool)
            .await
            .expect("query");
        assert_eq!(row.0, 1);
    }
}

