=== .dockerignore ===
# Keep the build context small and secrets out of image layers.
.git
/target
.env

=== .env.example ===
DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== .gitignore ===
/target
.env

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
actix-web = "4"
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
sea-orm = { version = "1", features = ["sqlx-postgres", "runtime-tokio-rustls"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== src/db.rs ===
//! Database connection (SeaORM + Postgres).

use sea_orm::{Database, DatabaseConnection, DbErr};

/// Connect to Postgres using the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Add entities under `src/entities/` and use the connection from your
/// handlers to run queries.
pub async fn connect() -> Result<DatabaseConnection, DbErr> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    Database::connect(&database_url).await
}

=== src/main.rs ===
use actix_web::{App, HttpServer, Responder, get};

mod db;

#[get("/")]
async fn root() -> impl Responder {
    "Hello from sample-app!"
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let conn = db::connect().await.expect("failed to connect to database");
    println!("listening on http://localhost:3000");
    HttpServer::new(move || {
        let app = App::new().service(root);
        app.app_data(actix_web::web::Data::new(conn.clone()))
    })
    .bind(("0.0.0.0", 3000))?
    .run()
    .await
}
