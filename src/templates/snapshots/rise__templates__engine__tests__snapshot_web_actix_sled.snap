=== src/db.rs ===
//! Embedded key-value storage (sled).

use sled::Db;

/// Open the embedded database at `DB_PATH` (defaults to a local `data/`
/// directory, created on first run).
pub fn open() -> Result<Db, sled::Error> {
    let path = std::env::var("DB_PATH").unwrap_or_else(|_| "data".to_owned());
    sled::open(path)
}

=== src/main.rs ===
use actix_web::{App, HttpServer, Responder, get};

mod db;

#[get("/")]
async fn root() -> impl Responder {
    "Hello from sample-app!"
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    let store = db::open().expect("failed to open the database");
    println!("listening on http://localhost:3000");
    HttpServer::new(move || {
        let app = App::new().service(root);
        app.app_data(actix_web::web::Data::new(store.clone()))
    })
    .bind(("0.0.0.0", 3000))?
    .run()
    .await
}
