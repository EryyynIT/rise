=== .env.example ===
# Signs the JWTs issued by /auth/login. Change this in production.
JWT_SECRET=change-me-in-production
DATABASE_URL=sqlite://data/app.db?mode=rwc

=== .gitignore ===
/target
.env
/data

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
axum = "0.8"
tokio = { version = "1", features = ["full"] }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
argon2 = "0.6"
# rust_crypto selects the pure-Rust HMAC backend (no ring/aws-lc C builds).
jsonwebtoken = { version = "11", features = ["rust_crypto"] }
serde = { version = "1", features = ["derive"] }
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "sqlite"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== README.md ===
# sample-app

axum web app generated by [rise](https://github.com/EryyynIT/rise).

Stack: axum + sqlite (embedded — no database server) + JWT auth.

## Prerequisites

- Rust — https://rustup.rs (`rise doctor` checks this machine)

## Run

```sh
cp .env.example .env  # set JWT_SECRET
cargo run
```

The server listens on http://localhost:3000.
`POST /auth/register` + `POST /auth/login` issue JWTs; `/api/me` takes one
as `Authorization: Bearer <token>`.

## Test

```sh
cargo test
```

## Docker

```sh
docker build -t sample-app .
```

```sh
docker run -p 3000:3000 -e JWT_SECRET=<a-long-random-string> sample-app
```

=== src/auth.rs ===
//! JWT auth: register, log in, and a protected example route.
//!
//! Users live in the project's database; passwords are hashed with argon2.
//! Tokens are signed with `JWT_SECRET` (see `.env.example`).

use argon2::{
    Argon2,
    password_hash::{PasswordHasher, PasswordVerifier, phc::PasswordHash},
};
use axum::{
    Json, Router,
    extract::{FromRequestParts, State},
    http::{StatusCode, header, request::Parts},
    routing::{get, post},
};
use jsonwebtoken::{DecodingKey, EncodingKey, Header, Validation};
use serde::{Deserialize, Serialize};
use std::sync::LazyLock;
type Db = sqlx::SqlitePool;

/// JSON body of the register and login endpoints.
#[derive(Deserialize)]
pub struct Credentials {
    username: String,
    password: String,
}

/// The JWT payload: subject = username, exp = 24 hours from issue.
#[derive(Serialize, Deserialize)]
struct Claims {
    sub: String,
    exp: usize,
}

static JWT_SECRET: LazyLock<String> =
    LazyLock::new(|| std::env::var("JWT_SECRET").expect("set JWT_SECRET (see .env.example)"));

/// Fail at startup, not on the first request, when JWT_SECRET is missing
/// or still the placeholder from .env.example.
pub fn check_secret() {
    LazyLock::force(&JWT_SECRET);
    assert!(
        !JWT_SECRET.is_empty(),
        "JWT_SECRET is set but empty — set a real secret (see .env.example)"
    );
    assert_ne!(
        JWT_SECRET.as_str(),
        "change-me-in-production",
        "set a real JWT_SECRET — the .env.example placeholder is public, so tokens it signs are forgeable"
    );
}

/// Create the users table when missing. Called once at startup.
pub async fn migrate(db: &Db) {
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS users (\
            id INTEGER PRIMARY KEY AUTOINCREMENT, \
            username TEXT NOT NULL UNIQUE, \
            password_hash TEXT NOT NULL)",
    )
    .execute(db)
    .await
    .expect("failed to create the users table");
}

/// Insert a user; false when the username is taken.
async fn create_user(db: &Db, username: &str, password_hash: &str) -> Result<bool, sqlx::Error> {
    let result = sqlx::query(
        "INSERT INTO users (username, password_hash) VALUES (?, ?) \
         ON CONFLICT (username) DO NOTHING",
    )
    .bind(username)
    .bind(password_hash)
    .execute(db)
    .await?;
    Ok(result.rows_affected() > 0)
}

async fn password_hash_of(db: &Db, username: &str) -> Result<Option<String>, sqlx::Error> {
    sqlx::query_scalar("SELECT password_hash FROM users WHERE username = ?")
        .bind(username)
        .fetch_optional(db)
        .await
}

/// The auth routes: register, login, and a protected example.
pub fn routes(db: Db) -> Router {
    Router::new()
        .route("/auth/register", post(register))
        .route("/auth/login", post(login))
        .route("/api/me", get(me))
        .with_state(db)
}

/// Register a new user: 201 Created, 409 when the name is taken, 400 on
/// empty credentials.
async fn register(State(db): State<Db>, Json(credentials): Json<Credentials>) -> StatusCode {
    if credentials.username.is_empty() || credentials.password.is_empty() {
        return StatusCode::BAD_REQUEST;
    }
    let Ok(password_hash) = hash_password(&credentials.password) else {
        return StatusCode::INTERNAL_SERVER_ERROR;
    };
    match create_user(&db, &credentials.username, &password_hash).await {
        Ok(true) => StatusCode::CREATED,
        Ok(false) => StatusCode::CONFLICT,
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR,
    }
}

/// Log in: 200 with a signed JWT in the body, 401 on bad credentials.
async fn login(
    State(db): State<Db>,
    Json(credentials): Json<Credentials>,
) -> Result<String, StatusCode> {
    let stored = password_hash_of(&db, &credentials.username)
        .await
        .map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)?;
    match stored {
        Some(hash) if verify_password(&hash, &credentials.password) => {
            issue_token(&credentials.username).map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)
        }
        _ => Err(StatusCode::UNAUTHORIZED),
    }
}

/// Protected example: returns the token's subject.
async fn me(user: AuthUser) -> String {
    format!("hello, {}", user.0)
}

/// Extracts the bearer token's subject; 401 when missing or invalid.
pub struct AuthUser(pub String);

impl<S> FromRequestParts<S> for AuthUser
where
    S: Send + Sync,
{
    type Rejection = StatusCode;

    async fn from_request_parts(parts: &mut Parts, _state: &S) -> Result<Self, Self::Rejection> {
        parts
            .headers
            .get(header::AUTHORIZATION)
            .and_then(|value| value.to_str().ok())
            .and_then(|value| value.strip_prefix("Bearer "))
            .and_then(validate_token)
            .map(|claims| AuthUser(claims.sub))
            .ok_or(StatusCode::UNAUTHORIZED)
    }
}

fn hash_password(password: &str) -> Result<String, argon2::password_hash::Error> {
    Ok(Argon2::default()
        .hash_password(password.as_bytes())?
        .to_string())
}

fn verify_password(hash: &str, password: &str) -> bool {
    PasswordHash::new(hash)
        .map(|hash| {
            Argon2::default()
                .verify_password(password.as_bytes(), &hash)
                .is_ok()
        })
        .unwrap_or(false)
}

fn issue_token(username: &str) -> Result<String, jsonwebtoken::errors::Error> {
    let claims = Claims {
        sub: username.to_owned(),
        exp: jsonwebtoken::get_current_timestamp() as usize + 24 * 60 * 60,
    };
    jsonwebtoken::encode(
        &Header::default(),
        &claims,
        &EncodingKey::from_secret(JWT_SECRET.as_bytes()),
    )
}

fn validate_token(token: &str) -> Option<Claims> {
    jsonwebtoken::decode::<Claims>(
        token,
        &DecodingKey::from_secret(JWT_SECRET.as_bytes()),
        &Validation::default(),
    )
    .ok()
    .map(|data| data.claims)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn a_hashed_password_verifies_and_a_wrong_one_does_not() {
        let hash = hash_password("correct horse").expect("hashing works");
        assert!(verify_password(&hash, "correct horse"));
        assert!(!verify_password(&hash, "a different password"));
        assert!(!verify_password("not a phc hash", "correct horse"));
    }
}

=== src/db.rs ===
//! Database connection pool (sqlx + SQLite, embedded — no server needed).

use sqlx::{SqlitePool, sqlite::SqlitePoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable,
/// defaulting to a local file at `data/app.db` (created on first run).
/// The app runs with zero setup — no `.env`, no database server.
pub async fn create_pool() -> Result<SqlitePool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL")
        .unwrap_or_else(|_| "sqlite://data/app.db?mode=rwc".to_owned());
    // `mode=rwc` creates the database file, but not its parent directory.
    if let Some(directory) = database_url
        .strip_prefix("sqlite://")
        // sqlx also accepts the short `sqlite:path` form.
        .or_else(|| database_url.strip_prefix("sqlite:"))
        .and_then(|rest| rest.split('?').next())
        .and_then(|path| std::path::Path::new(path).parent())
        .filter(|parent| !parent.as_os_str().is_empty())
    {
        std::fs::create_dir_all(directory).expect("create the database directory");
    }
    SqlitePoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}

=== src/main.rs ===
use axum::{Router, routing::get};

mod db;
mod auth;

#[tokio::main]
async fn main() {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let app = Router::new().route("/", get(root));
    let db = db::create_pool().await.expect("failed to connect to database");
    // Fail at startup, not on the first request, when JWT_SECRET is unset or the placeholder.
    auth::check_secret();
    // The users table behind /auth/register and /auth/login.
    auth::migrate(&db).await;
    let app = app.with_state(db.clone());
    // JWT auth: /auth/register, /auth/login and a protected /api/me.
    let app = app.merge(auth::routes(db));

    let listener = tokio::net::TcpListener::bind("0.0.0.0:3000")
        .await
        .expect("failed to bind port 3000");

    println!("listening on http://localhost:3000");
    axum::serve(listener, app).await.expect("server error");
}

async fn root() -> &'static str {
    "Hello from sample-app!"
}
