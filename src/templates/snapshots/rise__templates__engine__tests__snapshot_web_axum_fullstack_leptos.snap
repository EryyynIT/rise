---
source: src/templates/engine.rs
expression: "snapshot_output(&fullstack_spec(Backend::Axum, Frontend::Leptos))"
---
=== .dockerignore ===
# Keep the build context small: cargo-leptos output under target/ is
# rebuilt inside the image.
.git
/target

=== .gitignore ===
/target

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
leptos = { version = "0.8" }
leptos_meta = { version = "0.8" }
leptos_router = { version = "0.8" }
axum = { version = "0.8", optional = true }
leptos_axum = { version = "0.8", optional = true }
tokio = { version = "1", features = ["rt-multi-thread"], optional = true }
console_error_panic_hook = { version = "0.1", optional = true }
wasm-bindgen = { version = "0.2", optional = true }

[features]
hydrate = ["leptos/hydrate", "dep:console_error_panic_hook", "dep:wasm-bindgen"]
ssr = [
    "dep:axum",
    "dep:tokio",
    "dep:leptos_axum",
    "leptos/ssr",
    "leptos_meta/ssr",
    "leptos_router/ssr",
]

# Size-optimized profile for the WASM bundle in release mode.
[profile.wasm-release]
inherits = "release"
opt-level = "z"
lto = true
codegen-units = 1
panic = "abort"

# cargo-leptos reads this section; every key can be overridden by a
# LEPTOS_* environment variable (see the Dockerfile).
[package.metadata.leptos]
# Name of the JS/WASM/CSS bundle. Defaults to the crate name.
output-name = "sample-app"
# All cargo-leptos output lands here; the server reads files from it.
site-root = "target/site"
# The site-root-relative folder the compiled JS/WASM/CSS is written to.
site-pkg-dir = "pkg"
# Plain CSS (a .scss file would be compiled with dart-sass instead).
style-file = "style/main.css"
# Address the server binds to.
site-addr = "127.0.0.1:3000"
# WebSocket port for automatic reload in DEV.
reload-port = 3001
env = "DEV"
# The binary is built for the server, the library for the browser.
bin-features = ["ssr"]
bin-default-features = false
lib-features = ["hydrate"]
lib-default-features = false
lib-profile-release = "wasm-release"

=== Dockerfile ===
# Build the SSR binary and the WASM bundle with cargo-leptos.
FROM rust:1-slim AS builder
RUN cargo install --locked cargo-leptos && rustup target add wasm32-unknown-unknown
WORKDIR /app
COPY . .
RUN cargo leptos build --release

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /app/target/release/sample-app /usr/local/bin/server
COPY --from=builder /app/target/site /app/site
# The runtime image has no Cargo.toml, so the leptos configuration comes
# from environment variables (they override [package.metadata.leptos]).
ENV LEPTOS_ENV=PROD \
    LEPTOS_SITE_ADDR=0.0.0.0:3000 \
    LEPTOS_SITE_ROOT=/app/site
EXPOSE 3000
CMD ["server"]

=== src/app.rs ===
use leptos::prelude::*;
use leptos_meta::{MetaTags, Stylesheet, Title, provide_meta_context};
use leptos_router::{
    StaticSegment,
    components::{Route, Router, Routes},
};

/// The HTML shell every page is rendered into.
pub fn shell(options: LeptosOptions) -> impl IntoView {
    view! {
        <!DOCTYPE html>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <AutoReload options=options.clone() />
                <HydrationScripts options/>
                <MetaTags/>
            </head>
            <body>
                <App/>
            </body>
        </html>
    }
}

#[component]
pub fn App() -> impl IntoView {
    // Provides context that manages stylesheets, titles, meta tags, etc.
    provide_meta_context();

    view! {
        // injects a stylesheet into the document <head>
        // id=leptos means cargo-leptos will hot-reload this stylesheet
        <Stylesheet id="leptos" href="/pkg/sample-app.css"/>

        // sets the document title
        <Title text="Welcome to Leptos"/>

        // content for this welcome page
        <Router>
            <main>
                <Routes fallback=|| "Page not found.".into_view()>
                    <Route path=StaticSegment("") view=HomePage/>
                </Routes>
            </main>
        </Router>
    }
}

/// Renders the home page of your application.
#[component]
fn HomePage() -> impl IntoView {
    // Creates a reactive value to update the button
    let count = RwSignal::new(0);
    let on_click = move |_| *count.write() += 1;

    view! {
        <h1>"Welcome to Leptos!"</h1>
        <button on:click=on_click>"Click Me: " {count}</button>
    }
}

=== src/lib.rs ===
pub mod app;

#[cfg(feature = "hydrate")]
#[wasm_bindgen::prelude::wasm_bindgen]
pub fn hydrate() {
    use crate::app::*;
    console_error_panic_hook::set_once();
    leptos::mount::hydrate_body(App);
}

=== src/main.rs ===
#[cfg(feature = "ssr")]
#[tokio::main]
async fn main() {
    use axum::Router;
    use leptos::logging::log;
    use leptos::prelude::*;
    use leptos_axum::{LeptosRoutes, generate_route_list};
    use sample_app::app::*;

    let conf = get_configuration(None).expect("failed to load leptos configuration");
    let addr = conf.leptos_options.site_addr;
    let leptos_options = conf.leptos_options;
    // Generate the list of routes in your Leptos app.
    let routes = generate_route_list(App);

    let app = Router::new()
        .leptos_routes(&leptos_options, routes, {
            let leptos_options = leptos_options.clone();
            move || shell(leptos_options.clone())
        })
        .fallback(leptos_axum::file_and_error_handler(shell))
        .with_state(leptos_options);

    log!("listening on http://{}", &addr);
    let listener = tokio::net::TcpListener::bind(&addr)
        .await
        .expect("failed to bind");
    axum::serve(listener, app.into_make_service())
        .await
        .expect("failed to serve");
}

#[cfg(not(feature = "ssr"))]
pub fn main() {
    // No client-side main: the browser entry point is `hydrate` in lib.rs.
}

=== style/main.css ===
body {
    font-family: system-ui, sans-serif;
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    text-align: center;
}

button {
    font-size: 1.25rem;
    padding: 0.5rem 1rem;
    border: 2px solid #b7410e;
    border-radius: 0.5rem;
    background: transparent;
    cursor: pointer;
}

button:hover {
    background: #b7410e;
    color: white;
}
