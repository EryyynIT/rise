=== .dockerignore ===
# Keep the build context small and secrets out of image layers:
# cargo-leptos output under target/ is rebuilt inside the image.
.git
/target
.env

=== .env.example ===
# Signs the JWTs issued by /auth/login. Change this in production.
JWT_SECRET=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== .gitignore ===
