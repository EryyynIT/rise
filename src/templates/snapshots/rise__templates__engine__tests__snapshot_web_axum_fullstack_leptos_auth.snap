=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
leptos = { version = "0.8" }
leptos_meta = { version = "0.8" }
leptos_router = { version = "0.8" }
axum = { version = "0.8", optional = true }
leptos_axum = { version = "0.8", optional = true }
tokio = { version = "1", features = ["rt-multi-thread"], optional = true }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = { version = "0.15", optional = true }
argon2 = { version = "0.6", optional = true }
# rust_crypto selects the pure-Rust HMAC backend (no ring/aws-lc C builds).
jsonwebtoken = { version = "11", features = ["rust_crypto"], optional = true }
serde = { version = "1", features = ["derive"], optional = true }
console_error_panic_hook = { version = "0.1", optional = true }
wasm-bindgen = { version = "0.2", optional = true }
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"], optional = true }

[features]
hydrate = ["leptos/hydrate", "dep:console_error_panic_hook", "dep:wasm-bindgen"]
ssr = [
    "dep:axum",
    "dep:tokio",
    "dep:leptos_axum",
    "dep:dotenvy",
    "dep:argon2",
    "dep:jsonwebtoken",
    "dep:serde",
    "dep:sqlx",
    "leptos/ssr",
    "leptos_meta/ssr",
    "leptos_router/ssr",
]

# Size-optimized profile for the WASM bundle in release mode.
[profile.wasm-release]
inherits = "release"
opt-level = "z"
lto = true
codegen-units = 1
panic = "abort"

# cargo-leptos reads this section; every key can be overridden by a
# LEPTOS_* environment variable (see the Dockerfile).
[package.metadata.leptos]
# Name of the JS/WASM/CSS bundle. Defaults to the crate name.
output-name = "sample-app"
# All cargo-leptos output lands here; the server reads files from it.
site-root = "target/site"
# The site-root-relative folder the compiled JS/WASM/CSS is written to.
site-pkg-dir = "pkg"
# Plain CSS (a .scss file would be compiled with dart-sass instead).
style-file = "style/main.css"
# Address the server binds to.
site-addr = "127.0.0.1:3000"
# WebSocket port for automatic reload in DEV.
reload-port = 3001
env = "DEV"
# The binary is built for the server, the library for the browser.
bin-features = ["ssr"]
bin-default-features = false
lib-features = ["hydrate"]
lib-default-features = false
lib-profile-release = "wasm-release"

=== Dockerfile ===
# Build the SSR binary and the WASM bundle with cargo-leptos.
FROM rust:1-slim AS builder
RUN cargo install --locked cargo-leptos && rustup target add wasm32-unknown-unknown
WORKDIR /app
COPY . .
RUN cargo leptos build --release

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /app/target/release/sample-app /usr/local/bin/server
COPY --from=builder /app/target/site /app/site
# The runtime image has no Cargo.toml, so the leptos configuration comes
# from environment variables (they override [package.metadata.leptos]).
ENV LEPTOS_ENV=PROD \
    LEPTOS_SITE_ADDR=0.0.0.0:3000 \
    LEPTOS_SITE_ROOT=/app/site
EXPOSE 3000
CMD ["server"]

=== src/app.rs ===
use leptos::prelude::*;
use leptos_meta::{MetaTags, Stylesheet, Title, provide_meta_context};
use leptos_router::{
    StaticSegment,
    components::{Route, Router, Routes},
};

/// The HTML shell every page is rendered into.
pub fn shell(options: LeptosOptions) -> impl IntoView {
    view! {
        <!DOCTYPE html>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <AutoReload options=options.clone() />
                <HydrationScripts options/>
                <MetaTags/>
            </head>
            <body>
                <App/>
            </body>
        </html>
    }
}

#[component]
pub fn App() -> impl IntoView {
    // Provides context that manages stylesheets, titles, meta tags, etc.
    provide_meta_context();

    view! {
        // injects a stylesheet into the document <head>
        // id=leptos means cargo-leptos will hot-reload this stylesheet
        <Stylesheet id="leptos" href="/pkg/sample-app.css"/>

        // sets the document title
        <Title text="Welcome to Leptos"/>

        // content for this welcome page
        <Router>
            <main>
                <Routes fallback=|| "Page not found.".into_view()>
                    <Route path=StaticSegment("") view=HomePage/>
                </Routes>
            </main>
        </Router>
    }
}

/// Renders the home page of your application.
#[component]
fn HomePage() -> impl IntoView {
    // Creates a reactive value to update the button
    let count = RwSignal::new(0);
    let on_click = move |_| *count.write() += 1;
    // Runs on the server during SSR and streams the result to the client.
    let status = OnceResource::new(database_status());

    view! {
        <h1>"Welcome to Leptos!"</h1>
        <button on:click=on_click>"Click Me: " {count}</button>
        <Suspense fallback=|| view! { <p>"Checking the database…"</p> }>
            {move || {
                status.get().map(|result| {
                    view! { <p>"Database: " {result.unwrap_or_else(|e| e.to_string())}</p> }
                })
            }}
        </Suspense>
    }
}

/// Example server function: proves the database wiring works. The
/// connection is provided through the request context (created in
/// `main.rs`, see `src/db.rs` for the type) — replace the query with
/// your own.
#[server]
pub async fn database_status() -> Result<String, ServerFnError> {
    let pool = use_context::<sqlx::PgPool>()
        .ok_or_else(|| ServerFnError::new("database pool missing from the request context"))?;
    // Runtime-checked query: the project compiles without a live database.
    sqlx::query_scalar::<_, String>("SELECT 'connected'::text")
        .fetch_one(&pool)
        .await
        .map_err(|e| ServerFnError::new(format!("database query failed: {e}")))
}

=== src/auth.rs ===
//! JWT auth: register, log in, and a protected example route.
//!
//! Users live in the project's database; passwords are hashed with argon2.
//! Tokens are signed with `JWT_SECRET` (see `.env.example`).

use argon2::{
    Argon2,
    password_hash::{PasswordHasher, PasswordVerifier, phc::PasswordHash},
};
use axum::{
    Json, Router,
    extract::{FromRequestParts, State},
    http::{StatusCode, header, request::Parts},
    routing::{get, post},
};
use jsonwebtoken::{DecodingKey, EncodingKey, Header, Validation};
use serde::{Deserialize, Serialize};
use std::sync::LazyLock;
type Db = sqlx::PgPool;

/// JSON body of the register and login endpoints.
#[derive(Deserialize)]
pub struct Credentials {
    username: String,
    password: String,
}

/// The JWT payload: subject = username, exp = 24 hours from issue.
#[derive(Serialize, Deserialize)]
struct Claims {
    sub: String,
    exp: usize,
}

static JWT_SECRET: LazyLock<String> =
    LazyLock::new(|| std::env::var("JWT_SECRET").expect("set JWT_SECRET (see .env.example)"));

/// Create the users table when missing. Called once at startup.
pub async fn migrate(db: &Db) {
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS users (\
            id SERIAL PRIMARY KEY, \
            username TEXT NOT NULL UNIQUE, \
            password_hash TEXT NOT NULL)",
    )
    .execute(db)
    .await
    .expect("failed to create the users table");
}

/// Insert a user; false when the username is taken.
async fn create_user(db: &Db, username: &str, password_hash: &str) -> Result<bool, sqlx::Error> {
    let result = sqlx::query(
        "INSERT INTO users (username, password_hash) VALUES ($1, $2) \
         ON CONFLICT (username) DO NOTHING",
    )
    .bind(username)
    .bind(password_hash)
    .execute(db)
    .await?;
    Ok(result.rows_affected() > 0)
}

async fn password_hash_of(db: &Db, username: &str) -> Result<Option<String>, sqlx::Error> {
    sqlx::query_scalar("SELECT password_hash FROM users WHERE username = $1")
        .bind(username)
        .fetch_optional(db)
        .await
}

/// The auth routes: register, login, and a protected example.
pub fn routes(db: Db) -> Router {
    Router::new()
        .route("/auth/register", post(register))
        .route("/auth/login", post(login))
        .route("/api/me", get(me))
        .with_state(db)
}

/// Register a new user: 201 Created, 409 Conflict when the name is taken.
async fn register(State(db): State<Db>, Json(credentials): Json<Credentials>) -> StatusCode {
    let Ok(password_hash) = hash_password(&credentials.password) else {
        return StatusCode::INTERNAL_SERVER_ERROR;
    };
    match create_user(&db, &credentials.username, &password_hash).await {
        Ok(true) => StatusCode::CREATED,
        Ok(false) => StatusCode::CONFLICT,
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR,
    }
}

/// Log in: 200 with a signed JWT in the body, 401 on bad credentials.
async fn login(
    State(db): State<Db>,
    Json(credentials): Json<Credentials>,
) -> Result<String, StatusCode> {
    let stored = password_hash_of(&db, &credentials.username)
        .await
        .map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)?;
    match stored {
        Some(hash) if verify_password(&hash, &credentials.password) => {
            issue_token(&credentials.username).map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)
        }
        _ => Err(StatusCode::UNAUTHORIZED),
    }
}

/// Protected example: returns the token's subject.
async fn me(user: AuthUser) -> String {
    format!("hello, {}", user.0)
}

/// Extracts the bearer token's subject; 401 when missing or invalid.
pub struct AuthUser(pub String);

impl<S> FromRequestParts<S> for AuthUser
where
    S: Send + Sync,
{
    type Rejection = StatusCode;

    async fn from_request_parts(parts: &mut Parts, _state: &S) -> Result<Self, Self::Rejection> {
        parts
            .headers
            .get(header::AUTHORIZATION)
            .and_then(|value| value.to_str().ok())
            .and_then(|value| value.strip_prefix("Bearer "))
            .and_then(validate_token)
            .map(|claims| AuthUser(claims.sub))
            .ok_or(StatusCode::UNAUTHORIZED)
    }
}

fn hash_password(password: &str) -> Result<String, argon2::password_hash::Error> {
    Ok(Argon2::default()
        .hash_password(password.as_bytes())?
        .to_string())
}

fn verify_password(hash: &str, password: &str) -> bool {
    PasswordHash::new(hash)
        .map(|hash| {
            Argon2::default()
                .verify_password(password.as_bytes(), &hash)
                .is_ok()
        })
        .unwrap_or(false)
}

fn issue_token(username: &str) -> Result<String, jsonwebtoken::errors::Error> {
    let claims = Claims {
        sub: username.to_owned(),
        exp: jsonwebtoken::get_current_timestamp() as usize + 24 * 60 * 60,
    };
    jsonwebtoken::encode(
        &Header::default(),
        &claims,
        &EncodingKey::from_secret(JWT_SECRET.as_bytes()),
    )
}

fn validate_token(token: &str) -> Option<Claims> {
    jsonwebtoken::decode::<Claims>(
        token,
        &DecodingKey::from_secret(JWT_SECRET.as_bytes()),
        &Validation::default(),
    )
    .ok()
    .map(|data| data.claims)
}

=== src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}

=== src/lib.rs ===
pub mod app;
#[cfg(feature = "ssr")]
pub mod db;

#[cfg(feature = "hydrate")]
#[wasm_bindgen::prelude::wasm_bindgen]
pub fn hydrate() {
    use crate::app::*;
    console_error_panic_hook::set_once();
    leptos::mount::hydrate_body(App);
}

=== src/main.rs ===

#[cfg(feature = "ssr")]
mod auth;

#[cfg(feature = "ssr")]
#[tokio::main]
async fn main() {
    use axum::Router;
    use leptos::logging::log;
    use leptos::prelude::*;
    use leptos_axum::{LeptosRoutes, generate_route_list};
    use sample_app::app::*;
    use sample_app::db;

    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();

    let conf = get_configuration(None).expect("failed to load leptos configuration");
    let addr = conf.leptos_options.site_addr;
    let leptos_options = conf.leptos_options;
    // Generate the list of routes in your Leptos app.
    let routes = generate_route_list(App);
    let db = db::create_pool().await.expect("failed to connect to database");
    // The users table behind /auth/register and /auth/login.
    auth::migrate(&db).await;
    let auth_db = db.clone();

    let app = Router::new()
        // The database handle is provided through the request context:
        // server functions and SSR handlers read it with `use_context`
        // (see `database_status` in app.rs).
        .leptos_routes_with_context(
            &leptos_options,
            routes,
            move || provide_context(db.clone()),
            {
                let leptos_options = leptos_options.clone();
                move || shell(leptos_options.clone())
            },
        )
        .fallback(leptos_axum::file_and_error_handler(shell))
        .with_state(leptos_options);
    // JWT auth: /auth/register, /auth/login and a protected /api/me.
    let app = app.merge(auth::routes(auth_db));

    log!("listening on http://{}", &addr);
    let listener = tokio::net::TcpListener::bind(&addr)
        .await
        .expect("failed to bind");
    axum::serve(listener, app.into_make_service())
        .await
        .expect("failed to serve");
}

#[cfg(not(feature = "ssr"))]
pub fn main() {
    // No client-side main: the browser entry point is `hydrate` in lib.rs.
}

