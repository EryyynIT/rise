.git
**/target
**/dist
**/.env

=== .gitignore ===
/target
**/dist
.env

=== Cargo.toml ===
[workspace]
resolver = "3"
members = ["backend", "frontend"]

=== Dockerfile ===
# Build the WASM bundle with trunk.
FROM rust:1-slim AS frontend-builder
RUN cargo install --locked trunk && rustup target add wasm32-unknown-unknown
WORKDIR /build/frontend
COPY frontend .
RUN trunk build --release

# Build the backend (sqlx queries are checked at runtime, no DATABASE_URL
# is needed here).
FROM rust:1-slim AS backend-builder
WORKDIR /build
# tonic-prost-build compiles proto/hello.proto with protoc at build time.
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
COPY . .
COPY --from=frontend-builder /build/frontend/dist ./frontend/dist
RUN cargo build --release -p sample-app-backend

# Run: the backend serves the API and the frontend bundle.
FROM debian:bookworm-slim
WORKDIR /app
COPY --from=backend-builder /build/target/release/sample-app-backend /usr/local/bin/app
COPY --from=backend-builder /build/frontend/dist ./frontend/dist
EXPOSE 3000
EXPOSE 50051
CMD ["app"]

=== README.md ===
# sample-app

Fullstack Rust app generated by [rise](https://github.com/EryyynIT/rise):

- `backend/` — axum API server (`sample-app-backend`)
- `frontend/` — Yew single-page app compiled to WASM (`sample-app-frontend`)

## Prerequisites

```sh
rustup target add wasm32-unknown-unknown
cargo install trunk
```

The backend's gRPC API (port 50051) builds with protoc — the Protocol
Buffers compiler: https://grpc.io/docs/protoc-installation/

## Development

Two terminals from the workspace root:

```sh
cargo run -p sample-app-backend
```

```sh
cd frontend && trunk serve
```

The SPA is on http://localhost:8080; trunk proxies `/api` to the backend
on http://localhost:3000 (see `frontend/Trunk.toml`).

## Production

```sh
cd frontend && trunk build --release
cargo run --release -p sample-app-backend
```

The backend serves the API and the built `frontend/dist` bundle on
http://localhost:3000.

=== backend/.env.example ===
DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== backend/Cargo.toml ===
[package]
name = "sample-app-backend"
version = "0.1.0"
edition = "2024"

[dependencies]
axum = "0.8"
tokio = { version = "1", features = ["full"] }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
tonic = "0.14"
tonic-prost = "0.14"
prost = "0.14"
tower-http = { version = "0.6", features = ["fs"] }
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }

[build-dependencies]
tonic-prost-build = "0.14"

=== backend/build.rs ===
fn main() {
    // Requires protoc (the Protocol Buffers compiler) on the system:
    // https://grpc.io/docs/protoc-installation/
    tonic_prost_build::compile_protos("proto/hello.proto")
        .expect("failed to compile proto/hello.proto — is protoc installed?");
}

=== backend/proto/hello.proto ===
syntax = "proto3";

package hello;

// The greeting service.
service Greeter {
  rpc SayHello (HelloRequest) returns (HelloReply);
}

message HelloRequest {
  string name = 1;
}

message HelloReply {
  string message = 1;
}

=== backend/src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}

=== backend/src/grpc.rs ===
//! gRPC API: the Greeter service, generated from `proto/hello.proto`.

use tonic::{Request, Response, Status};

tonic::include_proto!("hello");

/// Greeter service implementation.
pub struct GreeterImpl;

#[tonic::async_trait]
impl greeter_server::Greeter for GreeterImpl {
    async fn say_hello(
        &self,
        request: Request<HelloRequest>,
    ) -> Result<Response<HelloReply>, Status> {
        let reply = HelloReply {
            message: format!("Hello from sample-app, {}!", request.into_inner().name),
        };
        Ok(Response::new(reply))
    }
}

/// Serve the gRPC API on its own port, next to the HTTP server.
pub async fn serve() -> Result<(), tonic::transport::Error> {
    let addr = "0.0.0.0:50051".parse().expect("valid gRPC address");
    println!("gRPC listening on http://localhost:50051");
    tonic::transport::Server::builder()
        .add_service(greeter_server::GreeterServer::new(GreeterImpl))
        .serve(addr)
        .await
}

=== backend/src/main.rs ===
use axum::{Router, routing::get};
use tower_http::services::ServeDir;

mod db;
mod grpc;

#[tokio::main]
async fn main() {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let app = Router::new().route("/api/hello", get(hello));
    let db = db::create_pool().await.expect("failed to connect to database");
    let app = app.with_state(db);
    // Serve the WASM bundle built by trunk (`frontend/dist`) next to the API.
    let app = app.fallback_service(ServeDir::new("frontend/dist"));

    let listener = tokio::net::TcpListener::bind("0.0.0.0:3000")
        .await
        .expect("failed to bind port 3000");

    println!("listening on http://localhost:3000");
    // The gRPC API runs on its own port, next to the HTTP server.
    tokio::spawn(async {
        if let Err(err) = grpc::serve().await {
            eprintln!("gRPC server error: {err}");
        }
    });
    axum::serve(listener, app).await.expect("server error");
}

/// Greeting for the WASM frontend.
async fn hello() -> &'static str {
    "Hello from sample-app!"
}

=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
      - "50051:50051"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      # Local-development password; override it when deploying for real.
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      # initdb on a slow disk must not eat into the retry budget.
      start_period: 10s
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

