=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
axum = "0.8"
tokio = { version = "1", features = ["full"] }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
tower_governor = "0.8"
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== README.md ===
# sample-app

axum web app generated by [rise](https://github.com/EryyynIT/rise).

Stack: axum + sqlx.

## Prerequisites

- Rust — https://rustup.rs (`rise doctor` checks this machine)
- a Postgres database — `.env.example` has the URL shape

## Run

```sh
cp .env.example .env  # set DATABASE_URL
cargo run
```

The server listens on http://localhost:3000.

## Test

```sh
cargo test
```

Database-backed tests are `#[ignore]`d until you pass a live
`DATABASE_URL` — `cargo test -- --include-ignored`.

## Docker

```sh
docker build -t sample-app .
```

```sh
docker compose up --build  # the app together with its Postgres service
```

=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      # Local-development password; override it when deploying for real.
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      # initdb on a slow disk must not eat into the retry budget.
      start_period: 10s
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

=== src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}

=== src/main.rs ===
use axum::{Router, routing::get};
use std::net::SocketAddr;
use tower_governor::{GovernorLayer, governor::GovernorConfigBuilder};

mod db;

#[tokio::main]
async fn main() {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let app = Router::new().route("/", get(root));
    let db = db::create_pool().await.expect("failed to connect to database");
    let app = app.with_state(db);
    // Rate limit requests per client IP: bursts of up to 5 requests,
    // then one request every 2 seconds on average.
    let governor_conf = GovernorConfigBuilder::default()
        .per_second(2)
        .burst_size(5)
        .finish()
        .expect("valid rate limiter configuration");
    // Governor's storage grows unboundedly without periodic cleanup.
    let limiter = governor_conf.limiter().clone();
    tokio::spawn(async move {
        loop {
            tokio::time::sleep(std::time::Duration::from_secs(60)).await;
            limiter.retain_recent();
        }
    });
    let app = app.layer(GovernorLayer::new(governor_conf));

    let listener = tokio::net::TcpListener::bind("0.0.0.0:3000")
        .await
        .expect("failed to bind port 3000");

    println!("listening on http://localhost:3000");
    // The per-IP rate limiter needs the peer address of each connection.
    axum::serve(listener, app.into_make_service_with_connect_info::<SocketAddr>())
        .await
        .expect("server error");
}

async fn root() -> &'static str {
    "Hello from sample-app!"
}
