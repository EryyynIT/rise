=== .dockerignore ===
# Keep the build context small and secrets out of image layers.
.git
/target
.env

=== .env.example ===
DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== .gitignore ===
/target
.env

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
axum = "0.8"
tokio = { version = "1", features = ["full"] }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
sea-orm = { version = "1", features = ["sqlx-postgres", "runtime-tokio-rustls"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      # Local-development password; override it when deploying for real.
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      # initdb on a slow disk must not eat into the retry budget.
      start_period: 10s
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

=== src/db.rs ===
//! Database connection (SeaORM + Postgres).

use sea_orm::{Database, DatabaseConnection, DbErr};

/// Connect to Postgres using the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Add entities under `src/entities/` and use the connection from your
/// handlers to run queries.
pub async fn connect() -> Result<DatabaseConnection, DbErr> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    Database::connect(&database_url).await
}

=== src/main.rs ===
use axum::{Router, routing::get};

mod db;

#[tokio::main]
async fn main() {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let app = Router::new().route("/", get(root));
    let db = db::connect().await.expect("failed to connect to database");
    let app = app.with_state(db);

    let listener = tokio::net::TcpListener::bind("0.0.0.0:3000")
        .await
        .expect("failed to bind port 3000");

    println!("listening on http://localhost:3000");
    axum::serve(listener, app).await.expect("server error");
}

async fn root() -> &'static str {
    "Hello from sample-app!"
}
