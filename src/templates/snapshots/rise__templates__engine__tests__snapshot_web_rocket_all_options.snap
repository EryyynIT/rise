=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
rocket = "0.5"
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
rocket_ws = "0.1"
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== README.md ===
# sample-app

rocket web app generated by [rise](https://github.com/EryyynIT/rise).

Stack: rocket + sqlx.

## Prerequisites

- Rust — https://rustup.rs (`rise doctor` checks this machine)
- a Postgres database — `.env.example` has the URL shape

## Run

```sh
cp .env.example .env  # set DATABASE_URL
cargo run
```

The server listens on http://localhost:3000.
`/ws` is a WebSocket echo endpoint.

## Test

```sh
cargo test
```

Database-backed tests are `#[ignore]`d until you pass a live
`DATABASE_URL` — `cargo test -- --include-ignored`.

## Docker

```sh
docker build -t sample-app .
docker run -p 3000:3000 sample-app
```

or `docker compose up --build` to start the app together with Postgres.

=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      # Local-development password; override it when deploying for real.
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      # initdb on a slow disk must not eat into the retry budget.
      start_period: 10s
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

=== src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}
=== src/main.rs ===
use rocket::routes;
use rocket::futures::{SinkExt, StreamExt};
use rocket_ws::{Channel, WebSocket};

mod db;

#[rocket::main]
async fn main() -> Result<(), rocket::Error> {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let db = db::create_pool().await.expect("failed to connect to database");
    // Listen on 0.0.0.0:3000 like every other backend rise generates;
    // rocket's own defaults are 127.0.0.1:8000.
    let config = rocket::Config {
        address: std::net::Ipv4Addr::UNSPECIFIED.into(),
        port: 3000,
        ..Default::default()
    };
    let rocket = rocket::custom(config)
        .manage(db)
        .mount("/", routes![root]);
    let rocket = rocket.mount("/", routes![ws_echo]);

    println!("listening on http://localhost:3000");
    rocket.launch().await?;
    Ok(())
}

#[rocket::get("/")]
fn root() -> &'static str {
    "Hello from sample-app!"
}

/// WebSocket echo endpoint: sends every message back.
#[rocket::get("/ws")]
fn ws_echo(ws: WebSocket) -> Channel<'static> {
    ws.channel(|mut stream| {
        Box::pin(async move {
            while let Some(message) = stream.next().await {
                stream.send(message?).await?;
            }
            Ok(())
        })
    })
}

#[cfg(test)]
mod tests {
    use super::*;
    use rocket::local::blocking::Client;

    #[test]
    fn root_says_hello() {
        let rocket = rocket::build().mount("/", routes![root]);
        let path = "/";
        let client = Client::tracked(rocket).expect("valid rocket");
        let response = client.get(path).dispatch();
        assert_eq!(response.status(), rocket::http::Status::Ok);
    }
}

#[cfg(test)]
mod db_tests {
    #[test]
    #[ignore = "needs a running Postgres (set DATABASE_URL)"]
    fn pool_connects() {
        // rocket's own tokio runtime, so the generated project needs no
        // direct tokio dependency.
        rocket::tokio::runtime::Runtime::new()
            .expect("tokio runtime")
            .block_on(async {
                let pool = crate::db::create_pool().await.expect("connect");
                let row: (i64,) = sqlx::query_as("SELECT 1")
                    .fetch_one(&pool)
                    .await
                    .expect("query");
                assert_eq!(row.0, 1);
            });
    }
}
