=== .dockerignore ===
# Keep the build context small and secrets out of image layers.
.git
/target
.env

=== .env.example ===
# Signs the JWTs issued by /auth/login. Change this in production.
JWT_SECRET=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== .gitignore ===
/target
.env

=== Cargo.toml ===
[package]
name = "sample-app"
version = "0.1.0"
edition = "2024"

[dependencies]
# The "json" feature powers the JSON bodies of the auth endpoints.
rocket = { version = "0.5", features = ["json"] }
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
argon2 = "0.6"
# rust_crypto selects the pure-Rust HMAC backend (no ring/aws-lc C builds).
jsonwebtoken = { version = "11", features = ["rust_crypto"] }
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }

=== Dockerfile ===
FROM rust:1-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/sample-app /usr/local/bin/app
EXPOSE 3000
CMD ["app"]

=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
      # Change this in production (see .env.example).
      JWT_SECRET: change-me-in-production
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

=== src/auth.rs ===
//! JWT auth: register, log in, and a protected example route.
//!
//! Users live in the project's database; passwords are hashed with argon2.
//! Tokens are signed with `JWT_SECRET` (see `.env.example`).

use argon2::{
    Argon2,
    password_hash::{PasswordHasher, PasswordVerifier, phc::PasswordHash},
};
use jsonwebtoken::{DecodingKey, EncodingKey, Header, Validation};
use rocket::serde::{Deserialize, Serialize, json::Json};
use rocket::{Request, State, get, http::Status, post, request::{FromRequest, Outcome}};
use std::sync::LazyLock;
type Db = sqlx::PgPool;

/// JSON body of the register and login endpoints.
#[derive(Deserialize)]
#[serde(crate = "rocket::serde")]
pub struct Credentials {
    username: String,
    password: String,
}

/// The JWT payload: subject = username, exp = 24 hours from issue.
#[derive(Serialize, Deserialize)]
#[serde(crate = "rocket::serde")]
struct Claims {
    sub: String,
    exp: usize,
}

static JWT_SECRET: LazyLock<String> =
    LazyLock::new(|| std::env::var("JWT_SECRET").expect("set JWT_SECRET (see .env.example)"));

/// Fail at startup, not on the first request, when JWT_SECRET is missing.
pub fn check_secret() {
    LazyLock::force(&JWT_SECRET);
}

/// Create the users table when missing. Called once at startup.
pub async fn migrate(db: &Db) {
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS users (\
            id SERIAL PRIMARY KEY, \
            username TEXT NOT NULL UNIQUE, \
            password_hash TEXT NOT NULL)",
    )
    .execute(db)
    .await
    .expect("failed to create the users table");
}

/// Insert a user; false when the username is taken.
async fn create_user(db: &Db, username: &str, password_hash: &str) -> Result<bool, sqlx::Error> {
    let result = sqlx::query(
        "INSERT INTO users (username, password_hash) VALUES ($1, $2) \
         ON CONFLICT (username) DO NOTHING",
    )
    .bind(username)
    .bind(password_hash)
    .execute(db)
    .await?;
    Ok(result.rows_affected() > 0)
}

async fn password_hash_of(db: &Db, username: &str) -> Result<Option<String>, sqlx::Error> {
    sqlx::query_scalar("SELECT password_hash FROM users WHERE username = $1")
        .bind(username)
        .fetch_optional(db)
        .await
}

/// Register a new user: 201 Created, 409 when the name is taken, 400 on
/// empty credentials.
#[post("/auth/register", data = "<credentials>", format = "application/json")]
pub async fn register(db: &State<Db>, credentials: Json<Credentials>) -> Status {
    if credentials.username.is_empty() || credentials.password.is_empty() {
        return Status::BadRequest;
    }
    let Ok(password_hash) = hash_password(&credentials.password) else {
        return Status::InternalServerError;
    };
    match create_user(db.inner(), &credentials.username, &password_hash).await {
        Ok(true) => Status::Created,
        Ok(false) => Status::Conflict,
        Err(_) => Status::InternalServerError,
    }
}

/// Log in: 200 with a signed JWT in the body, 401 on bad credentials.
#[post("/auth/login", data = "<credentials>", format = "application/json")]
pub async fn login(db: &State<Db>, credentials: Json<Credentials>) -> Result<String, Status> {
    let stored = password_hash_of(db.inner(), &credentials.username)
        .await
        .map_err(|_| Status::InternalServerError)?;
    match stored {
        Some(hash) if verify_password(&hash, &credentials.password) => {
            issue_token(&credentials.username).map_err(|_| Status::InternalServerError)
        }
        _ => Err(Status::Unauthorized),
    }
}

/// Protected example: returns the token's subject.
#[get("/api/me")]
pub fn me(user: AuthUser) -> String {
    format!("hello, {}", user.0)
}

/// Extracts the bearer token's subject; 401 when missing or invalid.
pub struct AuthUser(pub String);

#[rocket::async_trait]
impl<'r> FromRequest<'r> for AuthUser {
    type Error = ();

    async fn from_request(request: &'r Request<'_>) -> Outcome<Self, Self::Error> {
        match request
            .headers()
            .get_one("Authorization")
            .and_then(|value| value.strip_prefix("Bearer "))
            .and_then(validate_token)
        {
            Some(claims) => Outcome::Success(AuthUser(claims.sub)),
            None => Outcome::Error((Status::Unauthorized, ())),
        }
    }
}

fn hash_password(password: &str) -> Result<String, argon2::password_hash::Error> {
    Ok(Argon2::default()
        .hash_password(password.as_bytes())?
        .to_string())
}

fn verify_password(hash: &str, password: &str) -> bool {
    PasswordHash::new(hash)
        .map(|hash| {
            Argon2::default()
                .verify_password(password.as_bytes(), &hash)
                .is_ok()
        })
        .unwrap_or(false)
}

fn issue_token(username: &str) -> Result<String, jsonwebtoken::errors::Error> {
    let claims = Claims {
        sub: username.to_owned(),
        exp: jsonwebtoken::get_current_timestamp() as usize + 24 * 60 * 60,
    };
    jsonwebtoken::encode(
        &Header::default(),
        &claims,
        &EncodingKey::from_secret(JWT_SECRET.as_bytes()),
    )
}

fn validate_token(token: &str) -> Option<Claims> {
    jsonwebtoken::decode::<Claims>(
        token,
        &DecodingKey::from_secret(JWT_SECRET.as_bytes()),
        &Validation::default(),
    )
    .ok()
    .map(|data| data.claims)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn a_hashed_password_verifies_and_a_wrong_one_does_not() {
        let hash = hash_password("correct horse").expect("hashing works");
        assert!(verify_password(&hash, "correct horse"));
        assert!(!verify_password(&hash, "a different password"));
        assert!(!verify_password("not a phc hash", "correct horse"));
    }
}

=== src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}
=== src/main.rs ===
use rocket::routes;

mod db;
mod auth;

#[rocket::main]
async fn main() -> Result<(), rocket::Error> {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let db = db::create_pool().await.expect("failed to connect to database");
    // Fail at startup, not on the first request, when JWT_SECRET is unset.
    auth::check_secret();
    // The users table behind /auth/register and /auth/login.
    auth::migrate(&db).await;
    // Listen on 0.0.0.0:3000 like every other backend rise generates;
    // rocket's own defaults are 127.0.0.1:8000.
    let config = rocket::Config {
        address: std::net::Ipv4Addr::UNSPECIFIED.into(),
        port: 3000,
        ..Default::default()
    };
    let rocket = rocket::custom(config)
        .manage(db)
        .mount("/", routes![root]);
    // JWT auth: /auth/register, /auth/login and a protected /api/me.
    let rocket = rocket.mount("/", routes![auth::register, auth::login, auth::me]);

    println!("listening on http://localhost:3000");
    rocket.launch().await?;
    Ok(())
}

#[rocket::get("/")]
fn root() -> &'static str {
    "Hello from sample-app!"
}
