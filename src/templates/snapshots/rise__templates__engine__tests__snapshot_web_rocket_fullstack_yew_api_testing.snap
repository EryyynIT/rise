.git
**/target
**/dist
**/.env

=== .gitignore ===
/target
**/dist
.env

=== Cargo.toml ===
[workspace]
resolver = "3"
members = ["backend", "frontend"]

=== Dockerfile ===
# Build the WASM bundle with trunk.
FROM rust:1-slim AS frontend-builder
RUN cargo install --locked trunk && rustup target add wasm32-unknown-unknown
WORKDIR /build/frontend
COPY frontend .
RUN trunk build --release

# Build the backend (sqlx queries are checked at runtime, no DATABASE_URL
# is needed here).
FROM rust:1-slim AS backend-builder
WORKDIR /build
COPY . .
COPY --from=frontend-builder /build/frontend/dist ./frontend/dist
RUN cargo build --release -p sample-app-backend

# Run: the backend serves the API and the frontend bundle.
FROM debian:bookworm-slim
WORKDIR /app
COPY --from=backend-builder /build/target/release/sample-app-backend /usr/local/bin/app
COPY --from=backend-builder /build/frontend/dist ./frontend/dist
EXPOSE 3000
CMD ["app"]

=== README.md ===
# sample-app

Fullstack Rust app generated by [rise](https://github.com/EryyynIT/rise):

- `backend/` — rocket API server (`sample-app-backend`)
- `frontend/` — Yew single-page app compiled to WASM (`sample-app-frontend`)

## Prerequisites

```sh
rustup target add wasm32-unknown-unknown
cargo install trunk
```

## Development

Two terminals from the workspace root:

```sh
cargo run -p sample-app-backend
```

```sh
cd frontend && trunk serve
```

The SPA is on http://localhost:8080; trunk proxies `/api` to the backend
on http://localhost:3000 (see `frontend/Trunk.toml`).

## Production

```sh
cd frontend && trunk build --release
cargo run --release -p sample-app-backend
```

The backend serves the API and the built `frontend/dist` bundle on
http://localhost:3000.

=== backend/.env.example ===
DATABASE_URL=postgres://postgres:postgres@localhost/sample_app

=== backend/Cargo.toml ===
[package]
name = "sample-app-backend"
version = "0.1.0"
edition = "2024"

[dependencies]
rocket = "0.5"
# Loads .env (DATABASE_URL & co.) into the environment at startup.
dotenvy = "0.15"
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres"] }

=== backend/src/db.rs ===
//! Database connection pool (sqlx + Postgres).

use sqlx::{PgPool, postgres::PgPoolOptions};

/// Build a connection pool from the `DATABASE_URL` environment variable.
///
/// Copy `.env.example` to `.env` and adjust the URL for your database.
/// Queries use sqlx's runtime-checked API, so the project compiles without
/// a live database; `DATABASE_URL` is only needed at run time.
pub async fn create_pool() -> Result<PgPool, sqlx::Error> {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgPoolOptions::new()
        .max_connections(5)
        .connect(&database_url)
        .await
}
=== backend/src/main.rs ===
use rocket::routes;
use rocket::fs::{FileServer, NamedFile};
use std::path::PathBuf;

mod db;

#[rocket::main]
async fn main() -> Result<(), rocket::Error> {
    // Loads .env when present (DATABASE_URL & co.); absent is fine.
    let _ = dotenvy::dotenv();
    let db = db::create_pool().await.expect("failed to connect to database");
    // Listen on 0.0.0.0:3000 like every other backend rise generates;
    // rocket's own defaults are 127.0.0.1:8000.
    let config = rocket::Config {
        address: std::net::Ipv4Addr::UNSPECIFIED.into(),
        port: 3000,
        ..Default::default()
    };
    let rocket = rocket::custom(config)
        .manage(db)
        .mount("/", routes![hello])
        // Serve the WASM bundle built by trunk (`frontend/dist`) next to the API.
        .mount("/", FileServer::from("frontend/dist"))
        .mount("/", routes![spa_fallback]);

    println!("listening on http://localhost:3000");
    rocket.launch().await?;
    Ok(())
}

/// Greeting for the WASM frontend.
#[rocket::get("/api/hello")]
fn hello() -> &'static str {
    "Hello from sample-app!"
}

/// SPA fallback: anything that is neither an API route nor a file in
/// `frontend/dist` gets the frontend's `index.html`. The rank keeps it
/// behind the file server's routes (rank 10).
#[rocket::get("/<_path..>", rank = 20)]
async fn spa_fallback(_path: PathBuf) -> Option<NamedFile> {
    NamedFile::open("frontend/dist/index.html").await.ok()
}

#[cfg(test)]
mod tests {
    use super::*;
    use rocket::local::blocking::Client;

    #[test]
    fn root_says_hello() {
        let rocket = rocket::build().mount("/", routes![hello]);
        let path = "/api/hello";
        let client = Client::tracked(rocket).expect("valid rocket");
        let response = client.get(path).dispatch();
        assert_eq!(response.status(), rocket::http::Status::Ok);
    }
}
=== compose.yaml ===
# The app plus its Postgres database in one command: docker compose up --build.
# The app container gets DATABASE_URL pointing at the db service; the value
# in .env (localhost) keeps working for a local `cargo run`.
services:
  app:
    build: .
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db/sample_app
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17
    environment:
      # Local-development password; override it when deploying for real.
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: sample_app
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
      # initdb on a slow disk must not eat into the retry budget.
      start_period: 10s
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:

